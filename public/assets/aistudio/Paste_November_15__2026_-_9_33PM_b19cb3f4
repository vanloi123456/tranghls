<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kéo Co Kiến Thức - Chinh Phục Tri Thức</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background-color: #f0f9ff;
            user-select: none;
        }

        /* Animations */
        @keyframes tugging {
            0% { transform: translateX(0px) rotate(0deg); }
            25% { transform: translateX(-2px) rotate(-1deg); }
            50% { transform: translateX(0px) rotate(0deg); }
            75% { transform: translateX(2px) rotate(1deg); }
            100% { transform: translateX(0px) rotate(0deg); }
        }
        .anim-tug { animation: tugging 0.5s infinite; }

        @keyframes pop {
            0% { transform: scale(0.8); opacity: 0; }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }
        .anim-pop { animation: pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

        @keyframes bounce-slow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .anim-bounce { animation: bounce-slow 2s infinite; }

        @keyframes fireworks {
            0% { transform: translate(var(--x), var(--initialY)); width: var(--initialSize); opacity: 1; }
            50% { width: 0.5rem; opacity: 1; }
            100% { width: 0; opacity: 0; transform: translate(var(--x), var(--y)); }
        }
        .firework {
            position: absolute;
            top: 50%; left: 50%;
            width: 0.5rem; height: 0.5rem;
            border-radius: 50%;
            animation: fireworks 1s ease-out forwards;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }
        .anim-shake { animation: shake 0.5s; }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        .glass-panel {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .btn-3d {
            transition: all 0.1s;
            box-shadow: 0 4px 0 0 var(--shadow-color);
        }
        .btn-3d:active {
            transform: translateY(4px);
            box-shadow: 0 0 0 0 var(--shadow-color);
        }

        .rope-pattern {
            background-image: repeating-linear-gradient(
                45deg,
                #8B4513 0px,
                #8B4513 10px,
                #A0522D 10px,
                #A0522D 20px
            );
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef, useCallback } = React;

        // --- TẠO ÂM THANH ĐƠN GIẢN (Web Audio API) ---
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const playSound = (type) => {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            osc.connect(gainNode);
            gainNode.connect(audioCtx.destination);

            if (type === 'correct') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(440, audioCtx.currentTime); // A4
                osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.1); // A5
                gainNode.gain.setValueAtTime(0.5, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.5);
            } else if (type === 'wrong') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(300, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(150, audioCtx.currentTime + 0.3);
                gainNode.gain.setValueAtTime(0.5, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.5);
            } else if (type === 'win') {
                osc.type = 'square';
                osc.frequency.setValueAtTime(523.25, audioCtx.currentTime); // C5
                setTimeout(() => {
                    if(audioCtx.state === 'suspended') return;
                    const osc2 = audioCtx.createOscillator();
                    const gain2 = audioCtx.createGain();
                    osc2.connect(gain2); gain2.connect(audioCtx.destination);
                    osc2.type = 'square';
                    osc2.frequency.setValueAtTime(659.25, audioCtx.currentTime); // E5
                    gain2.gain.setValueAtTime(0.3, audioCtx.currentTime);
                    gain2.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
                    osc2.start(); osc2.stop(audioCtx.currentTime + 0.5);
                }, 150);
                setTimeout(() => {
                    if(audioCtx.state === 'suspended') return;
                    const osc3 = audioCtx.createOscillator();
                    const gain3 = audioCtx.createGain();
                    osc3.connect(gain3); gain3.connect(audioCtx.destination);
                    osc3.type = 'square';
                    osc3.frequency.setValueAtTime(783.99, audioCtx.currentTime); // G5
                    gain3.gain.setValueAtTime(0.3, audioCtx.currentTime);
                    gain3.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 1);
                    osc3.start(); osc3.stop(audioCtx.currentTime + 1);
                }, 300);
                gainNode.gain.setValueAtTime(0.3, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.5);
            }
        };

        // --- COMPONENTS ---

        // Hiệu ứng pháo hoa
        const Fireworks = () => {
            const colors = ['#ef4444', '#3b82f6', '#f59e0b', '#10b981', '#a855f7'];
            const particles = Array.from({ length: 30 });
            return (
                <div className="absolute inset-0 pointer-events-none z-50 overflow-hidden">
                    {particles.map((_, i) => {
                        const style = {
                            '--x': `${(Math.random() - 0.5) * 400}px`,
                            '--y': `${(Math.random() - 0.5) * 400}px`,
                            '--initialY': `${(Math.random() - 0.5) * 50}px`,
                            '--initialSize': `${Math.random() * 0.5 + 0.2}rem`,
                            backgroundColor: colors[Math.floor(Math.random() * colors.length)],
                            left: `${Math.random() * 100}%`,
                            top: `${Math.random() * 100}%`
                        };
                        return <div key={i} className="firework" style={style}></div>;
                    })}
                </div>
            );
        };

        const App = () => {
            // STATE CHÍNH
            const [phase, setPhase] = useState('setup'); // setup, create_questions, playing, end
            const fileInputRef = useRef(null);
            
            // THIẾT LẬP (Mặc định trống)
            const [settings, setSettings] = useState({
                gameName: '',
                team1Name: '',
                team2Name: '',
                stepsPerCorrect: '',
                isTimed: false,
                timeLimit: '',
                turnMode: 'alternate' // 'alternate' hoặc 'manual'
            });

            // CÂU HỎI (Mặc định trống)
            const [questions, setQuestions] = useState([]);

            // TRẠNG THÁI TRÒ CHƠI
            const [gameState, setGameState] = useState({
                currentQIndex: 0,
                currentTurn: 1, // 1: Đội 1 (Đỏ), 2: Đội 2 (Xanh)
                ropePos: 0, // 0 là giữa, âm là về Đội 1, dương là về Đội 2. Giới hạn -100 đến 100
                team1Score: 0,
                team2Score: 0,
                isPaused: false,
                timeLeft: 0,
                feedback: null, // 'correct', 'wrong', null
                winner: null, // 1 hoặc 2
                playedQuestions: [] // Lưu ID các câu đã chơi
            });

            const [soundEnabled, setSoundEnabled] = useState(true);

            // --- FULLSCREEN LOGIC ---
            const toggleFullScreen = () => {
                if (!document.fullscreenElement) {
                    document.documentElement.requestFullscreen().catch(err => {
                        console.log(`Error attempting to enable fullscreen: ${err.message}`);
                    });
                } else {
                    if (document.exitFullscreen) {
                        document.exitFullscreen();
                    }
                }
            };

            // --- HANDLERS CHO THIẾT LẬP ---
            const handleSettingChange = (e) => {
                const { name, value, type, checked } = e.target;
                setSettings(prev => ({
                    ...prev,
                    [name]: type === 'checkbox' ? checked : value
                }));
            };

            // --- HANDLERS CHO CÂU HỎI ---
            const addQuestion = (type = 'multiple') => {
                const newQ = {
                    id: Date.now(),
                    type: type,
                    text: '',
                    options: type === 'multiple' ? ['', '', '', ''] : [],
                    correctAnswer: ''
                };
                setQuestions([...questions, newQ]);
            };

            const updateQuestion = (id, field, value, optionIndex = null) => {
                setQuestions(questions.map(q => {
                    if (q.id === id) {
                        if (optionIndex !== null) {
                            const newOptions = [...q.options];
                            newOptions[optionIndex] = value;
                            return { ...q, options: newOptions };
                        }
                        return { ...q, [field]: value };
                    }
                    return q;
                }));
            };

            const deleteQuestion = (id) => {
                if(window.confirm("Bạn có chắc chắn muốn xóa câu hỏi này?")) {
                    setQuestions(questions.filter(q => q.id !== id));
                }
            };

            const moveQuestion = (index, direction) => {
                const newQ = [...questions];
                if (direction === 'up' && index > 0) {
                    [newQ[index - 1], newQ[index]] = [newQ[index], newQ[index - 1]];
                } else if (direction === 'down' && index < newQ.length - 1) {
                    [newQ[index + 1], newQ[index]] = [newQ[index], newQ[index + 1]];
                }
                setQuestions(newQ);
            };

            const deleteAllQuestions = () => {
                if(window.confirm("CẢNH BÁO: Xóa TOÀN BỘ câu hỏi bạn đã nhập?")) {
                    setQuestions([]);
                }
            };

            // --- QUẢN LÝ NHẬP/XUẤT FILE WORD ---
            const parseQuestionsFromText = (text) => {
                const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 0);
                let newQuestions = [];
                let currentQ = null;
                let newSettings = { ...settings };
                
                for(let i=0; i<lines.length; i++) {
                    let line = lines[i];
                    
                    if (line.toLowerCase().startsWith('tên trò chơi:')) { newSettings.gameName = line.split(':')[1].trim(); continue; }
                    if (line.toLowerCase().startsWith('đội 1:')) { newSettings.team1Name = line.split(':')[1].trim(); continue; }
                    if (line.toLowerCase().startsWith('đội 2:')) { newSettings.team2Name = line.split(':')[1].trim(); continue; }
                    
                    let qMatch = line.match(/^Câu\s*\d+\s*[:\.\-]\s*(.*)/i);
                    if (qMatch) {
                        if (currentQ) newQuestions.push(currentQ);
                        currentQ = {
                            id: Date.now() + i,
                            type: 'short',
                            text: qMatch[1].trim(),
                            options: ['', '', '', ''],
                            correctAnswer: ''
                        };
                        continue;
                    }
                    
                    if (currentQ) {
                        let optMatch = line.match(/^([A-D])[\.\:\)]\s*(.*)/i);
                        if (optMatch) {
                            currentQ.type = 'multiple';
                            let optIdx = optMatch[1].toUpperCase().charCodeAt(0) - 65;
                            if (optIdx >= 0 && optIdx <= 3) {
                                currentQ.options[optIdx] = optMatch[2].trim();
                            }
                        } else {
                            let ansMatch = line.match(/^Đáp\s*án\s*[:\.\-]\s*(.*)/i);
                            if (ansMatch) {
                                let ans = ansMatch[1].trim();
                                if (currentQ.type === 'multiple') {
                                    let ansChar = ans.charAt(0).toUpperCase();
                                    if (['A','B','C','D'].includes(ansChar)) {
                                        currentQ.correctAnswer = (ansChar.charCodeAt(0) - 65).toString();
                                    }
                                } else {
                                    currentQ.correctAnswer = ans;
                                }
                            } else {
                                // Nếu là dòng văn bản bình thường, nối vào nội dung câu hỏi
                                if (currentQ.type === 'short' && !currentQ.correctAnswer && !line.startsWith('---')) {
                                    if (currentQ.text === "") currentQ.text = line;
                                    else currentQ.text += "\n" + line;
                                }
                            }
                        }
                    }
                }
                if (currentQ) newQuestions.push(currentQ);
                
                if (newQuestions.length > 0) {
                    setQuestions(newQuestions);
                    setSettings(newSettings);
                    alert(`Đã nhập thành công ${newQuestions.length} câu hỏi từ file Word!`);
                } else {
                    alert("Không tìm thấy câu hỏi nào! Hãy đảm bảo file Word có cấu trúc: 'Câu 1: ...', 'A. ...', 'Đáp án: ...'");
                }
            };

            const exportToWord = () => {
                if (questions.length === 0) {
                    alert("Chưa có câu hỏi nào để xuất!");
                    return;
                }
                let content = `<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
                <head><meta charset='utf-8'><title>Bo Cau Hoi</title></head><body>`;
                content += `<h2>Kéo Co Kiến Thức - Bộ Câu Hỏi</h2>`;
                content += `<p>Tên trò chơi: ${settings.gameName || ''}</p>`;
                content += `<p>Đội 1: ${settings.team1Name || ''}</p>`;
                content += `<p>Đội 2: ${settings.team2Name || ''}</p>`;
                content += `<p>---</p>`;
                
                questions.forEach((q, i) => {
                    content += `<p><b>Câu ${i+1}: ${q.text}</b></p>`;
                    if (q.type === 'multiple') {
                        content += `<p>A. ${q.options[0] || ''}</p>`;
                        content += `<p>B. ${q.options[1] || ''}</p>`;
                        content += `<p>C. ${q.options[2] || ''}</p>`;
                        content += `<p>D. ${q.options[3] || ''}</p>`;
                        
                        let correctChar = '';
                        if(q.correctAnswer !== '') {
                            correctChar = String.fromCharCode(65 + parseInt(q.correctAnswer));
                        }
                        content += `<p>Đáp án: ${correctChar}</p>`;
                    } else {
                        content += `<p>Đáp án: ${q.correctAnswer}</p>`;
                    }
                    content += `<p></p>`;
                });
                content += `</body></html>`;
                
                const blob = new Blob(['\ufeff', content], { type: 'application/msword' });
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                const safeName = settings.gameName ? settings.gameName.replace(/[^a-z0-9]/gi, '_').toLowerCase() : 'bocauhoi';
                link.download = `keoco_${safeName}.doc`;
                document.body.appendChild(link);
                link.click();
                link.remove();
            };

            const handleImportWord = (e) => {
                const file = e.target.files[0];
                if (!file) return;
                
                const ext = file.name.split('.').pop().toLowerCase();
                
                if (ext === 'docx') {
                    const reader = new FileReader();
                    reader.onload = (event) => {
                        // Sử dụng mammoth.js để giải mã file .docx thực thụ
                        mammoth.extractRawText({arrayBuffer: event.target.result})
                            .then((result) => {
                                parseQuestionsFromText(result.value);
                            })
                            .catch(err => {
                                alert("Lỗi khi đọc file DOCX: " + err.message);
                            });
                    };
                    reader.readAsArrayBuffer(file);
                } else if (ext === 'doc' || ext === 'txt') {
                    const reader = new FileReader();
                    reader.onload = (event) => {
                        let text = event.target.result;
                        if (ext === 'doc') {
                            // Chuyển đổi file doc(html) thành plain text
                            const tempDiv = document.createElement('div');
                            tempDiv.innerHTML = text;
                            text = tempDiv.innerText || tempDiv.textContent;
                        }
                        parseQuestionsFromText(text);
                    };
                    reader.readAsText(file);
                } else if (ext === 'json') {
                     // Hỗ trợ dự phòng trường hợp giáo viên dùng file .json cũ
                     const reader = new FileReader();
                     reader.onload = (event) => {
                          try {
                               const data = JSON.parse(event.target.result);
                               if(data.questions) {
                                   setQuestions(data.questions);
                                   if(data.settings) setSettings(data.settings);
                                   alert("Đã nhập thành công từ file JSON cũ!");
                               }
                          } catch (err) {
                              alert("File không hợp lệ");
                          }
                     };
                     reader.readAsText(file);
                } else {
                    alert("Vui lòng chọn file Word (.doc, .docx) hoặc .txt");
                }
                e.target.value = null; // reset
            };

            // --- GAME LOGIC ---
            const startGame = () => {
                // Validation
                if (!settings.gameName || !settings.team1Name || !settings.team2Name || !settings.stepsPerCorrect) {
                    alert("Vui lòng điền đầy đủ Tên trò chơi, Tên 2 đội và Số bước kéo!");
                    return;
                }
                if (questions.length === 0) {
                    alert("Vui lòng tạo ít nhất 1 câu hỏi!");
                    setPhase('create_questions');
                    return;
                }
                // Check if questions are filled
                const invalidQ = questions.find(q => !q.text || (q.type === 'multiple' && q.options.some(o => !o)) || q.correctAnswer === '');
                if (invalidQ) {
                    alert("Có câu hỏi chưa được điền đầy đủ nội dung hoặc chưa chọn đáp án đúng!");
                    setPhase('create_questions');
                    return;
                }

                setGameState({
                    currentQIndex: 0,
                    currentTurn: 1,
                    ropePos: 0,
                    team1Score: 0,
                    team2Score: 0,
                    isPaused: false,
                    timeLeft: settings.isTimed ? parseInt(settings.timeLimit) || 30 : 0,
                    feedback: null,
                    winner: null,
                    playedQuestions: []
                });
                setPhase('playing');
            };

            const handleAnswer = (answerGiven) => {
                if (gameState.isPaused || gameState.feedback || gameState.winner) return;

                const currentQ = questions[gameState.currentQIndex];
                const isCorrect = answerGiven.toString().toLowerCase() === currentQ.correctAnswer.toString().toLowerCase();

                if (isCorrect) {
                    if (soundEnabled) playSound('correct');
                    const step = parseInt(settings.stepsPerCorrect);
                    const newPos = gameState.currentTurn === 1 ? gameState.ropePos - step : gameState.ropePos + step;
                    
                    let newScore1 = gameState.team1Score;
                    let newScore2 = gameState.team2Score;
                    if(gameState.currentTurn === 1) newScore1++; else newScore2++;

                    setGameState(prev => ({
                        ...prev,
                        feedback: 'correct',
                        ropePos: newPos,
                        team1Score: newScore1,
                        team2Score: newScore2,
                        playedQuestions: [...prev.playedQuestions, currentQ.id]
                    }));

                    // Check Win
                    setTimeout(() => {
                        if (newPos <= -100) {
                            if(soundEnabled) playSound('win');
                            setGameState(prev => ({ ...prev, winner: 1 }));
                            setPhase('end');
                        } else if (newPos >= 100) {
                            if(soundEnabled) playSound('win');
                            setGameState(prev => ({ ...prev, winner: 2 }));
                            setPhase('end');
                        } else {
                            nextTurn();
                        }
                    }, 2000);

                } else {
                    if (soundEnabled) playSound('wrong');
                    setGameState(prev => ({
                        ...prev,
                        feedback: 'wrong',
                        playedQuestions: [...prev.playedQuestions, currentQ.id]
                    }));
                    setTimeout(() => {
                        nextTurn();
                    }, 2000);
                }
            };

            const nextTurn = () => {
                setGameState(prev => {
                    let nextIndex = prev.currentQIndex + 1;
                    if (nextIndex >= questions.length) {
                        // Hết câu hỏi
                        alert("Đã hết câu hỏi! Trò chơi kết thúc hòa hoặc chưa có đội nào kéo qua vạch.");
                        return { ...prev, winner: 'draw', feedback: null };
                    }
                    return {
                        ...prev,
                        feedback: null,
                        currentQIndex: nextIndex,
                        currentTurn: settings.turnMode === 'alternate' ? (prev.currentTurn === 1 ? 2 : 1) : prev.currentTurn,
                        timeLeft: settings.isTimed ? parseInt(settings.timeLimit) || 30 : 0
                    };
                });
                if(gameState.winner === 'draw') setPhase('end');
            };

            // Timer logic
            useEffect(() => {
                let interval = null;
                if (phase === 'playing' && settings.isTimed && !gameState.isPaused && !gameState.feedback && !gameState.winner && gameState.timeLeft > 0) {
                    interval = setInterval(() => {
                        setGameState(prev => {
                            if (prev.timeLeft <= 1) {
                                clearInterval(interval);
                                // Time out -> Wrong answer behavior
                                if (soundEnabled) playSound('wrong');
                                setTimeout(nextTurn, 2000);
                                return { ...prev, timeLeft: 0, feedback: 'wrong' };
                            }
                            return { ...prev, timeLeft: prev.timeLeft - 1 };
                        });
                    }, 1000);
                }
                return () => clearInterval(interval);
            }, [phase, settings.isTimed, gameState.isPaused, gameState.feedback, gameState.winner, gameState.timeLeft]);


            // --- RENDERERS ---

            const renderSetup = () => (
                <div className="max-w-4xl mx-auto p-6 mt-10 glass-panel rounded-2xl anim-pop">
                    <h1 className="text-4xl font-black text-center text-blue-600 mb-8 drop-shadow-md uppercase">
                        Thiết Lập Trò Chơi
                    </h1>
                    
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div className="col-span-1 md:col-span-2">
                            <label className="block text-gray-700 font-bold mb-2">Tên Trò Chơi (Chủ đề):</label>
                            <input type="text" name="gameName" value={settings.gameName} onChange={handleSettingChange} 
                                className="w-full p-4 text-xl border-2 border-blue-300 rounded-xl focus:outline-none focus:border-blue-500 shadow-inner placeholder-gray-400" placeholder="VD: Ôn tập Toán lớp 3..."/>
                        </div>

                        <div className="bg-red-50 p-4 rounded-xl border-2 border-red-200">
                            <label className="block text-red-700 font-bold mb-2 text-lg"><i className="fa-solid fa-flag text-red-500 mr-2"></i>Tên Đội 1 (Bên Trái):</label>
                            <input type="text" name="team1Name" value={settings.team1Name} onChange={handleSettingChange} 
