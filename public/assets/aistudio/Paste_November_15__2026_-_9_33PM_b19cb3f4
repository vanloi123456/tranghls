                            <i className="fa-regular fa-folder-open text-6xl text-gray-300 mb-4"></i>
                            <p className="text-xl text-gray-500 font-bold">Chưa có câu hỏi nào. Hãy thêm câu hỏi mới!</p>
                        </div>
                    ) : (
                        <div className="space-y-6 max-h-[60vh] overflow-y-auto pr-2">
                            {questions.map((q, index) => (
                                <div key={q.id} className="p-4 bg-white border-2 border-gray-200 rounded-xl shadow-sm relative group">
                                    <div className="absolute top-2 right-2 flex space-x-2 opacity-50 group-hover:opacity-100 transition-opacity">
                                        <button onClick={() => moveQuestion(index, 'up')} disabled={index === 0} className="p-2 text-gray-500 hover:text-blue-500 disabled:opacity-30"><i className="fa-solid fa-arrow-up"></i></button>
                                        <button onClick={() => moveQuestion(index, 'down')} disabled={index === questions.length - 1} className="p-2 text-gray-500 hover:text-blue-500 disabled:opacity-30"><i className="fa-solid fa-arrow-down"></i></button>
                                        <button onClick={() => deleteQuestion(q.id)} className="p-2 text-red-500 hover:bg-red-50 rounded"><i className="fa-solid fa-xmark"></i></button>
                                    </div>
                                    
                                    <div className="flex items-start gap-4">
                                        <div className="bg-purple-100 text-purple-800 font-black w-10 h-10 rounded-full flex items-center justify-center shrink-0 border-2 border-purple-300">
                                            {index + 1}
                                        </div>
                                        <div className="flex-1 w-full">
                                            <textarea 
                                                value={q.text} 
                                                onChange={(e) => updateQuestion(q.id, 'text', e.target.value)}
                                                placeholder="Nhập nội dung câu hỏi tại đây..."
                                                className="w-full p-3 text-lg border border-gray-300 rounded-lg focus:outline-none focus:border-purple-500 mb-4 resize-none h-24"
                                            />

                                            {q.type === 'multiple' ? (
                                                <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                                                    {q.options.map((opt, oIndex) => (
                                                        <div key={oIndex} className={`flex items-center p-2 rounded-lg border-2 ${q.correctAnswer === oIndex.toString() ? 'border-green-500 bg-green-50' : 'border-gray-200'}`}>
                                                            <input 
                                                                type="radio" 
                                                                name={`correct-${q.id}`} 
                                                                checked={q.correctAnswer === oIndex.toString()}
                                                                onChange={() => updateQuestion(q.id, 'correctAnswer', oIndex.toString())}
                                                                className="w-5 h-5 mr-3 text-green-600 cursor-pointer"
                                                            />
                                                            <input 
                                                                type="text" 
                                                                value={opt}
                                                                onChange={(e) => updateQuestion(q.id, 'options', e.target.value, oIndex)}
                                                                placeholder={`Phương án ${String.fromCharCode(65 + oIndex)}`}
                                                                className="flex-1 p-2 border-b border-transparent focus:border-gray-300 bg-transparent outline-none"
                                                            />
                                                        </div>
                                                    ))}
                                                </div>
                                            ) : (
                                                <div className="bg-blue-50 p-4 rounded-lg border-2 border-blue-200">
                                                    <label className="block text-blue-800 font-bold mb-2">Đáp án đúng (chính xác từng chữ/số):</label>
                                                    <input 
                                                        type="text" 
                                                        value={q.correctAnswer}
                                                        onChange={(e) => updateQuestion(q.id, 'correctAnswer', e.target.value)}
                                                        placeholder="Nhập đáp án ngắn..."
                                                        className="w-full p-3 border border-blue-300 rounded-lg outline-none focus:border-blue-500 font-bold"
                                                    />
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    )}
                    
                    <div className="mt-8 text-center border-t pt-6">
                        <button onClick={startGame} className="px-10 py-4 bg-green-500 text-white font-bold rounded-xl text-2xl btn-3d" style={{'--shadow-color': '#166534'}}>
                            <i className="fa-solid fa-play mr-2"></i> Sẵn Sàng Bắt Đầu
                        </button>
                    </div>
                </div>
            );

            // --- THE ARENA ---
            const renderArena = () => {
                const isTugging = !gameState.isPaused && !gameState.feedback && !gameState.winner;
                
                // Giới hạn hiển thị rope
                let displayRopePos = gameState.ropePos;
                if(displayRopePos < -100) displayRopePos = -100;
                if(displayRopePos > 100) displayRopePos = 100;

                return (
                    <div className="w-full h-64 md:h-80 relative overflow-hidden rounded-2xl border-4 border-white shadow-xl mt-4" style={{
                        background: 'linear-gradient(to bottom, #87CEEB 0%, #87CEEB 50%, #4ade80 50%, #22c55e 100%)'
                    }}>
                        {/* Background Elements */}
                        <div className="absolute top-10 left-10 text-white opacity-80"><i className="fa-solid fa-cloud text-5xl"></i></div>
                        <div className="absolute top-5 right-20 text-white opacity-80"><i className="fa-solid fa-cloud text-4xl"></i></div>
                        <div className="absolute top-0 right-0 text-yellow-300 text-6xl m-4 anim-bounce"><i className="fa-solid fa-sun"></i></div>

                        {/* Lines */}
                        <div className="absolute top-1/2 bottom-0 left-1/2 w-2 bg-white -translate-x-1/2 z-10 border-x border-gray-200"></div> {/* Center */}
                        <div className="absolute top-1/2 bottom-0 left-[10%] w-2 bg-red-500 -translate-x-1/2 z-10 border-x border-red-700 opacity-80"></div> {/* T1 Win */}
                        <div className="absolute top-1/2 bottom-0 right-[10%] w-2 bg-blue-500 translate-x-1/2 z-10 border-x border-blue-700 opacity-80"></div> {/* T2 Win */}

                        {/* Text Indicators */}
                        <div className="absolute bottom-2 left-[10%] text-red-700 font-bold bg-white/70 px-2 rounded -translate-x-1/2 text-xs md:text-sm">VẠCH ĐÍCH {settings.team1Name.substring(0,5)}</div>
                        <div className="absolute bottom-2 right-[10%] text-blue-700 font-bold bg-white/70 px-2 rounded translate-x-1/2 text-xs md:text-sm">VẠCH ĐÍCH {settings.team2Name.substring(0,5)}</div>

                        {/* Rope Container (moves) */}
                        {/* Rope container's origin is center. TranslateX moves it based on percentage of half-width. 
                            100 score = 40% of container width movement (from center 50% to edge 10% or 90%)
                        */}
                        <div 
                            className="absolute top-[60%] left-1/2 w-full h-20 -translate-x-1/2 -translate-y-1/2 transition-all duration-700 ease-in-out z-20 flex items-center justify-center"
                            style={{ transform: `translate(calc(-50% + ${displayRopePos * 0.4}%), -50%)` }}
                        >
                            {/* The Rope itself */}
                            <div className={`w-[200%] h-3 md:h-5 rounded-full rope-pattern shadow-md border border-yellow-900 ${isTugging ? 'anim-tug' : ''}`}></div>
                            
                            {/* Center Knot (Cờ) */}
                            <div className="absolute left-1/2 -translate-x-1/2 w-6 h-10 bg-red-600 rounded shadow-md z-30"></div>

                            {/* Team 1 Characters (Left side of rope) */}
                            <div className="absolute left-[20%] -translate-y-6 flex space-x-2 md:space-x-6 z-30">
                                {[1,2,3].map(i => (
                                    <div key={`t1-${i}`} className={`flex flex-col items-center ${isTugging ? 'anim-bounce' : ''}`} style={{animationDelay: `${i*0.1}s`}}>
                                        <div className="w-10 h-10 md:w-14 md:h-14 bg-red-500 rounded-full border-4 border-white shadow-lg flex items-center justify-center">
                                            <i className="fa-solid fa-face-smile text-white text-xl md:text-2xl"></i>
                                        </div>
                                        <div className="w-6 md:w-8 h-8 md:h-12 bg-red-600 mt-1 rounded shadow-lg"></div>
                                    </div>
                                ))}
                            </div>

                            {/* Team 2 Characters (Right side of rope) */}
                            <div className="absolute right-[20%] -translate-y-6 flex space-x-2 md:space-x-6 z-30">
                                {[1,2,3].map(i => (
                                    <div key={`t2-${i}`} className={`flex flex-col items-center ${isTugging ? 'anim-bounce' : ''}`} style={{animationDelay: `${i*0.1}s`}}>
                                        <div className="w-10 h-10 md:w-14 md:h-14 bg-blue-500 rounded-full border-4 border-white shadow-lg flex items-center justify-center">
                                            <i className="fa-solid fa-face-laugh-squint text-white text-xl md:text-2xl"></i>
                                        </div>
                                        <div className="w-6 md:w-8 h-8 md:h-12 bg-blue-600 mt-1 rounded shadow-lg"></div>
                                    </div>
                                ))}
                            </div>
                        </div>

                        {/* Effects Layer */}
                        {gameState.feedback === 'correct' && (
                            <div className="absolute inset-0 z-40 flex items-center justify-center bg-white/20">
                                <h2 className="text-5xl md:text-7xl font-black text-yellow-400 drop-shadow-[0_5px_5px_rgba(0,0,0,0.8)] anim-pop border-4 border-transparent" style={{WebkitTextStroke: '2px #b45309'}}>CHÍNH XÁC!</h2>
                                <Fireworks />
                            </div>
                        )}
                        {gameState.feedback === 'wrong' && (
                            <div className="absolute inset-0 z-40 flex items-center justify-center bg-gray-900/30">
                                <h2 className="text-4xl md:text-6xl font-black text-white drop-shadow-[0_5px_5px_rgba(0,0,0,0.8)] anim-shake border-4 border-transparent" style={{WebkitTextStroke: '2px #000'}}>CỐ LÊN NHÉ!</h2>
                            </div>
                        )}
                    </div>
                );
            };

            const renderPlaying = () => {
                const currentQ = questions[gameState.currentQIndex];
                
                // Progress calculation
                const t1Progress = Math.max(0, Math.min(100, (gameState.ropePos * -1 + 100) / 2));
                const t2Progress = Math.max(0, Math.min(100, (gameState.ropePos + 100) / 2));

                return (
                    <div className="h-screen w-full flex flex-col bg-[#f0f9ff]">
                        {/* Header Panel */}
                        <div className="bg-white shadow-md p-2 flex justify-between items-center z-10 shrink-0">
                            <h1 className="text-xl md:text-2xl font-black text-gray-800 uppercase ml-4">{settings.gameName}</h1>
                            <div className="flex space-x-2 mr-2">
                                <button onClick={() => setSoundEnabled(!soundEnabled)} className="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center text-gray-700 hover:bg-gray-300">
                                    <i className={`fa-solid ${soundEnabled ? 'fa-volume-high' : 'fa-volume-xmark'}`}></i>
                                </button>
                                <button onClick={() => setGameState(p => ({...p, isPaused: !p.isPaused}))} className="w-10 h-10 bg-yellow-100 text-yellow-700 rounded-full flex items-center justify-center hover:bg-yellow-200">
                                    <i className={`fa-solid ${gameState.isPaused ? 'fa-play' : 'fa-pause'}`}></i>
                                </button>
                                <button onClick={toggleFullScreen} className="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center text-gray-700 hover:bg-gray-300 hidden md:flex">
                                    <i className="fa-solid fa-expand"></i>
                                </button>
                                <button onClick={() => { if(window.confirm("Thoát trò chơi?")) setPhase('setup') }} className="px-4 py-2 bg-red-100 text-red-700 font-bold rounded-lg hover:bg-red-200">
                                    Thoát
                                </button>
                            </div>
                        </div>

                        {/* Top Info Bar: Scores & Progress */}
                        <div className="flex justify-between items-center p-4 shrink-0 bg-white/50 backdrop-blur">
                            {/* Team 1 Stats */}
                            <div className={`flex flex-col items-start w-1/3 p-2 rounded-xl transition-all ${gameState.currentTurn === 1 ? 'bg-red-100 border-2 border-red-400 shadow-md transform scale-105' : 'opacity-70'}`}>
                                <div className="text-red-700 font-black text-lg md:text-2xl flex items-center">
                                    <i className="fa-solid fa-shield-halved mr-2"></i> {settings.team1Name}
                                </div>
                                <div className="text-red-900 font-bold text-sm">Điểm: {gameState.team1Score}</div>
                                <div className="w-full bg-gray-200 rounded-full h-2.5 mt-2">
                                    <div className="bg-red-500 h-2.5 rounded-full transition-all duration-500" style={{ width: `${t1Progress}%` }}></div>
                                </div>
                            </div>

                            {/* Center Status / Timer */}
                            <div className="flex flex-col items-center justify-center w-1/3">
                                {settings.isTimed && (
                                    <div className={`text-4xl md:text-5xl font-black ${gameState.timeLeft <= 10 ? 'text-red-600 anim-pop' : 'text-gray-800'}`}>
                                        <i className="fa-regular fa-clock mr-2"></i>{gameState.timeLeft}s
                                    </div>
                                )}
                                <div className="text-sm font-bold text-gray-500 uppercase tracking-widest mt-2">
                                    Câu {gameState.currentQIndex + 1} / {questions.length}
                                </div>
                            </div>

                            {/* Team 2 Stats */}
                            <div className={`flex flex-col items-end w-1/3 p-2 rounded-xl transition-all ${gameState.currentTurn === 2 ? 'bg-blue-100 border-2 border-blue-400 shadow-md transform scale-105' : 'opacity-70'}`}>
                                <div className="text-blue-700 font-black text-lg md:text-2xl flex items-center">
                                    {settings.team2Name} <i className="fa-solid fa-shield-halved ml-2"></i>
                                </div>
                                <div className="text-blue-900 font-bold text-sm">Điểm: {gameState.team2Score}</div>
                                <div className="w-full bg-gray-200 rounded-full h-2.5 mt-2 flex justify-end">
                                    <div className="bg-blue-500 h-2.5 rounded-full transition-all duration-500" style={{ width: `${t2Progress}%` }}></div>
                                </div>
                            </div>
                        </div>

                        {/* Arena */}
                        <div className="px-4 shrink-0">
                            {renderArena()}
                        </div>

                        {/* Question Area */}
                        <div className="flex-1 flex flex-col items-center justify-center p-4 relative">
                            {gameState.isPaused ? (
                                <div className="text-4xl font-black text-gray-500 uppercase tracking-widest">ĐÃ TẠM DỪNG</div>
                            ) : (
                                <div className="w-full max-w-5xl bg-white p-6 md:p-10 rounded-3xl shadow-[0_10px_40px_rgba(0,0,0,0.1)] border-4 border-gray-100 flex flex-col h-full justify-center anim-pop">
                                    
                                    {/* Select Team to answer if manual mode */}
                                    {settings.turnMode === 'manual' && !gameState.feedback && (
                                        <div className="flex justify-center space-x-4 mb-6">
                                            <span className="font-bold text-gray-500 self-center">Chọn đội trả lời:</span>
                                            <button onClick={() => setGameState(p => ({...p, currentTurn: 1}))} className={`px-4 py-2 rounded-lg font-bold border-2 ${gameState.currentTurn===1 ? 'bg-red-500 text-white border-red-600' : 'bg-white text-red-500 border-red-300'}`}>
                                                {settings.team1Name}
                                            </button>
                                            <button onClick={() => setGameState(p => ({...p, currentTurn: 2}))} className={`px-4 py-2 rounded-lg font-bold border-2 ${gameState.currentTurn===2 ? 'bg-blue-500 text-white border-blue-600' : 'bg-white text-blue-500 border-blue-300'}`}>
                                                {settings.team2Name}
                                            </button>
                                        </div>
                                    )}

                                    {/* Question Text */}
                                    <h2 className="text-2xl md:text-4xl font-bold text-center text-gray-800 mb-8 leading-tight">
                                        {currentQ.text}
                                    </h2>

                                    {/* Answers */}
                                    {currentQ.type === 'multiple' ? (
                                        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mt-auto">
                                            {currentQ.options.map((opt, idx) => {
                                                if(!opt) return null; // Skip empty options
                                                
                                                // Style based on feedback state
                                                let btnClass = "bg-white text-gray-700 border-2 border-gray-300 hover:border-gray-500 hover:bg-gray-50";
                                                if (gameState.feedback) {
                                                    if (idx.toString() === currentQ.correctAnswer) {
                                                        btnClass = "bg-green-500 text-white border-green-600 anim-pop shadow-[0_0_15px_rgba(34,197,94,0.7)]"; // Always highlight correct
                                                    } else {
                                                        btnClass = "bg-gray-100 text-gray-400 border-gray-200 opacity-50"; // Dim others
                                                    }
                                                }

                                                return (
                                                    <button 
                                                        key={idx}
                                                        disabled={gameState.feedback !== null}
                                                        onClick={() => handleAnswer(idx)}
                                                        className={`p-4 md:p-6 rounded-2xl text-xl md:text-2xl font-bold transition-all transform active:scale-95 text-left flex items-center ${btnClass}`}
                                                    >
                                                        <span className="w-10 h-10 rounded-full flex items-center justify-center bg-black/10 mr-4 shrink-0 font-black">
                                                            {String.fromCharCode(65 + idx)}
                                                        </span>
                                                        {opt}
                                                    </button>
                                                )
                                            })}
                                        </div>
                                    ) : (
                                        <div className="w-full max-w-2xl mx-auto flex flex-col items-center mt-auto">
                                            {gameState.feedback ? (
                                                <div className="text-center">
                                                    <div className="text-lg text-gray-500 mb-2">Đáp án chính xác:</div>
                                                    <div className="text-3xl font-black text-green-600 bg-green-100 px-8 py-4 rounded-xl border-2 border-green-300 anim-pop">
                                                        {currentQ.correctAnswer}
                                                    </div>
                                                </div>
                                            ) : (
                                                <form onSubmit={(e) => {
                                                    e.preventDefault();
                                                    handleAnswer(e.target.shortAnswer.value);
                                                }} className="w-full">
                                                    <input 
                                                        type="text" 
                                                        name="shortAnswer"
                                                        placeholder="Đội nhập câu trả lời vào đây..." 
                                                        className="w-full p-6 text-2xl border-4 border-gray-300 rounded-2xl focus:outline-none focus:border-blue-500 text-center font-bold"
                                                        autoComplete="off"
                                                    />
                                                    <button type="submit" className="w-full mt-4 p-4 bg-blue-600 text-white text-2xl font-bold rounded-xl hover:bg-blue-700 btn-3d" style={{'--shadow-color': '#1d4ed8'}}>
                                                        Chốt Đáp Án
                                                    </button>
                                                </form>
                                            )}
                                        </div>
                                    )}
                                </div>
                            )}
                        </div>
                    </div>
                );
            };

            const renderEndScreen = () => {
                let winnerName = gameState.winner === 1 ? settings.team1Name : (gameState.winner === 2 ? settings.team2Name : 'HÒA NHAU');
                let winnerColor = gameState.winner === 1 ? 'text-red-500' : (gameState.winner === 2 ? 'text-blue-500' : 'text-purple-500');
                let winnerBg = gameState.winner === 1 ? 'bg-red-50' : (gameState.winner === 2 ? 'bg-blue-50' : 'bg-purple-50');

                return (
                    <div className={`min-h-screen flex flex-col items-center justify-center p-6 ${winnerBg} relative overflow-hidden`}>
                        <Fireworks />
                        <Fireworks />
                        
                        <div className="glass-panel p-10 md:p-16 rounded-3xl text-center z-10 max-w-4xl w-full shadow-2xl anim-pop">
                            <i className="fa-solid fa-trophy text-7xl md:text-9xl text-yellow-400 drop-shadow-lg mb-6 anim-bounce"></i>
                            
                            <h2 className="text-3xl md:text-5xl font-bold text-gray-700 mb-2 uppercase">Chiến Thắng Thuộc Về</h2>
                            <h1 className={`text-6xl md:text-8xl font-black ${winnerColor} mb-10 drop-shadow-md uppercase tracking-wide border-b-4 pb-6`}>
                                {winnerName}
                            </h1>

                            <div className="grid grid-cols-2 gap-8 mb-12">
                                <div className="bg-white p-6 rounded-2xl shadow border-2 border-red-200">
                                    <h3 className="text-xl font-bold text-gray-500 mb-2">{settings.team1Name}</h3>
                                    <p className="text-4xl font-black text-red-600">{gameState.team1Score} <span className="text-lg text-gray-400">câu đúng</span></p>
                                </div>
                                <div className="bg-white p-6 rounded-2xl shadow border-2 border-blue-200">
                                    <h3 className="text-xl font-bold text-gray-500 mb-2">{settings.team2Name}</h3>
                                    <p className="text-4xl font-black text-blue-600">{gameState.team2Score} <span className="text-lg text-gray-400">câu đúng</span></p>
                                </div>
                            </div>

                            <div className="flex flex-col md:flex-row justify-center space-y-4 md:space-y-0 md:space-x-6">
                                <button onClick={startGame} className="px-8 py-4 bg-green-500 text-white font-bold rounded-xl text-xl btn-3d hover:bg-green-400" style={{'--shadow-color': '#166534'}}>
                                    <i className="fa-solid fa-rotate-right mr-2"></i> Chơi Lại (Giữ Câu Hỏi)
                                </button>
                                <button onClick={() => setPhase('setup')} className="px-8 py-4 bg-blue-500 text-white font-bold rounded-xl text-xl btn-3d hover:bg-blue-400" style={{'--shadow-color': '#1e3a8a'}}>
                                    <i className="fa-solid fa-gear mr-2"></i> Quay Về Thiết Lập
                                </button>
                            </div>
                        </div>
                    </div>
                );
            }

            // --- MAIN RENDER ---
            return (
                <div className="min-h-screen relative">
                    {/* Background Pattern */}
                    <div className="absolute inset-0 pointer-events-none opacity-5" style={{
                        backgroundImage: 'radial-gradient(#444cf7 2px, transparent 2px), radial-gradient(#444cf7 2px, #e5e5f7 2px)',
                        backgroundSize: '40px 40px',
                        backgroundPosition: '0 0, 20px 20px'
                    }}></div>

                    {phase === 'setup' && renderSetup()}
                    {phase === 'create_questions' && renderQuestionManager()}
                    {phase === 'playing' && renderPlaying()}
                    {phase === 'end' && renderEndScreen()}
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>