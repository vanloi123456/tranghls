                            <i className="fa-solid fa-list-check mr-2"></i> Soạn Câu Hỏi ({questions.length})
                        </button>
                        <button onClick={startGame} className="px-8 py-4 bg-green-500 text-white font-bold rounded-xl text-xl btn-3d" style={{'--shadow-color': '#166534'}}>
                            <i className="fa-solid fa-play mr-2"></i> Bắt Đầu Chơi
                        </button>
                    </div>
                </div>
            );

            const renderQuestionManager = () => (
                <div className="max-w-5xl mx-auto p-6 mt-10 glass-panel rounded-2xl anim-pop">
                    <div className="flex flex-col md:flex-row justify-between items-center mb-6 border-b pb-4 gap-4">
                        <h2 className="text-3xl font-black text-purple-700 uppercase"><i className="fa-solid fa-pen-to-square mr-3"></i>Soạn Bộ Câu Hỏi</h2>
                        <div className="flex flex-wrap gap-2 justify-center">
                            <button onClick={() => fileInputRef.current.click()} className="px-4 py-2 bg-indigo-100 text-indigo-700 font-bold rounded-lg hover:bg-indigo-200 transition">
                                <i className="fa-solid fa-file-word mr-2"></i> Nhập từ Word
                            </button>
                            <button onClick={exportToWord} className="px-4 py-2 bg-blue-100 text-blue-700 font-bold rounded-lg hover:bg-blue-200 transition">
                                <i className="fa-solid fa-file-word mr-2"></i> Xuất ra Word
                            </button>
                            <button onClick={() => setPhase('setup')} className="px-4 py-2 bg-gray-500 text-white font-bold rounded-lg hover:bg-gray-600 transition">
                                <i className="fa-solid fa-arrow-left mr-2"></i> Quay Lại
                            </button>
                            <input type="file" accept=".doc,.docx,.txt,.json" ref={fileInputRef} onChange={handleImportWord} className="hidden" style={{display: 'none'}} />
                        </div>
                    </div>

                    <div className="flex gap-4 mb-6">
                        <button onClick={() => addQuestion('multiple')} className="flex-1 py-3 bg-blue-100 text-blue-700 border-2 border-blue-400 font-bold rounded-xl hover:bg-blue-200 transition">
                            <i className="fa-solid fa-plus-circle mr-2"></i> Thêm Câu Hỏi Trắc Nghiệm
                        </button>
                        <button onClick={() => addQuestion('short')} className="flex-1 py-3 bg-green-100 text-green-700 border-2 border-green-400 font-bold rounded-xl hover:bg-green-200 transition">
