        // --- 4. DỰNG BỤC TRƯNG BÀY 3D TỪ DANH SÁCH SẢN PHẨM CỦA QUẢN TRỊ VIÊN ---
        // Hỗ trợ thêm nhiều sản phẩm trên mỗi khu: tự động chia lưới nhiều hàng/cột khoa học
        function rebuildProductDisplays() {
            if (!dynamicProductGroup || !dynamicCarpetGroup) return;

            // Xóa các bục và thảm khu vực cũ trước khi dựng lại
            while (dynamicProductGroup.children.length > 0) {
                dynamicProductGroup.remove(dynamicProductGroup.children[0]);
            }
            while (dynamicCarpetGroup.children.length > 0) {
                dynamicCarpetGroup.remove(dynamicCarpetGroup.children[0]);
            }
            interactiveMeshes = [];
            hoveredObject = null;

            // Nhóm sản phẩm theo từng khu vực
            const grouped = {
                ai_apps: [],
                games: [],
                materials: [],
                experiments: [],
                creative: []
            };

            products.forEach(p => {
                if (grouped[p.zone]) {
                    grouped[p.zone].push(p);
                }
            });

            // Quy tắc bố trí lưới đa hàng cho từng phân khu để không bị tràn tường khi thêm nhiều sản phẩm:
            // - Các khu hai bên tường (ai_apps, games, materials, experiments): xếp tối đa 3 bục/cột dọc theo trục Z,
            //   nếu nhiều hơn 3 sản phẩm sẽ tự động mở rộng thêm các hàng tiến dần vào phía trung tâm (trục X).
            // - Khu phía sau (creative): xếp tối đa 5 bục/hàng ngang theo trục X,
            //   nếu nhiều hơn 5 sản phẩm sẽ tự động mở rộng thêm các hàng tiến về phía trước (trục Z).
            const layoutRules = {
                ai_apps:     { baseX: -20.2, baseZ: 8,   primaryAxis: 'z', maxPerLine: 3, itemStep: 3.9, rowDir: 1,  rowStep: 3.8, rotY: Math.PI / 2 },
                games:       { baseX: 20.2,  baseZ: 8,   primaryAxis: 'z', maxPerLine: 3, itemStep: 3.9, rowDir: -1, rowStep: 3.8, rotY: -Math.PI / 2 },
                materials:   { baseX: -20.2, baseZ: -8,  primaryAxis: 'z', maxPerLine: 3, itemStep: 3.9, rowDir: 1,  rowStep: 3.8, rotY: Math.PI / 2 },
                experiments: { baseX: 20.2,  baseZ: -8,  primaryAxis: 'z', maxPerLine: 3, itemStep: 3.9, rowDir: -1, rowStep: 3.8, rotY: -Math.PI / 2 },
                creative:    { baseX: 0,     baseZ: -24, primaryAxis: 'x', maxPerLine: 5, itemStep: 3.9, rowDir: 1,  rowStep: 3.8, rotY: 0 }
            };

            Object.keys(grouped).forEach(zoneKey => {
                const items = grouped[zoneKey];
                const rule = layoutRules[zoneKey];
                const zoneMeta = EXHIBITION_ZONES[zoneKey];

                // Tính số hàng cần thiết để vẽ thảm ánh sáng phân khu tương ứng
                const rowCount = Math.max(1, Math.ceil(items.length / rule.maxPerLine));
                const carpetDepth = 6 + (rowCount - 1) * rule.rowStep;
                const carpetWidth = rule.primaryAxis === 'z' ? carpetDepth : 18;
                const carpetLength = rule.primaryAxis === 'z' ? 12.5 : carpetDepth;

                const carpetCenterX = rule.primaryAxis === 'z'
                    ? rule.baseX + rule.rowDir * ((rowCount - 1) * rule.rowStep) / 2
                    : rule.baseX;
                const carpetCenterZ = rule.primaryAxis === 'x'
                    ? rule.baseZ + rule.rowDir * ((rowCount - 1) * rule.rowStep) / 2
                    : rule.baseZ;

                const carpet = new THREE.Mesh(
                    new THREE.PlaneGeometry(carpetWidth, carpetLength),
                    new THREE.MeshBasicMaterial({
                        color: zoneMeta.hex,
                        transparent: true,
                        opacity: 0.14
                    })
                );
                carpet.rotation.x = -Math.PI / 2;
                carpet.position.set(carpetCenterX, 0.015, carpetCenterZ);
                dynamicCarpetGroup.add(carpet);

                // Nếu khu vực chưa có sản phẩm nào -> Đặt 1 bục chờ trạng thái sẵn sàng (không phải sản phẩm giả)
                if (items.length === 0) {
                    const emptyStand = createPedestalMesh({
                        isEmptySlot: true,
                        zoneMeta: zoneMeta,
                        title: 'KHU VỰC SẴN SÀNG TRƯNG BÀY',
                        subtitle: 'Nhấn trực tiếp vào bục này để thêm sản phẩm mới'
                    });
                    emptyStand.position.set(rule.baseX, 0, rule.baseZ);
                    emptyStand.rotation.y = rule.rotY;
                    dynamicProductGroup.add(emptyStand);
                    return;
                }

                // Xếp nhiều sản phẩm theo lưới hàng/cột cân đối
                items.forEach((prod, idx) => {
                    const rowIndex = Math.floor(idx / rule.maxPerLine);
                    const colIndex = idx % rule.maxPerLine;

                    // Số lượng phần tử thực tế trên hàng hiện tại để căn giữa hàng đó
                    const itemsInThisRow = Math.min(rule.maxPerLine, items.length - rowIndex * rule.maxPerLine);
                    const totalLineSpan = (itemsInThisRow - 1) * rule.itemStep;
                    const lineOffset = -totalLineSpan / 2 + colIndex * rule.itemStep;
                    const depthOffset = rowIndex * rule.rowStep * rule.rowDir;

                    let px = rule.baseX;
                    let pz = rule.baseZ;

                    if (rule.primaryAxis === 'z') {
                        pz += lineOffset;
                        px += depthOffset;
                    } else {
                        px += lineOffset;
                        pz += depthOffset;
                    }

                    const stand = createPedestalMesh({
                        isEmptySlot: false,
                        product: prod,
                        zoneMeta: zoneMeta,
                        title: prod.name,
                        subtitle: prod.desc
                    });
                    stand.position.set(px, 0, pz);
                    stand.rotation.y = rule.rotY;
                    dynamicProductGroup.add(stand);
                });
            });
        }

        // Hàm tạo mô hình 3D một bục trưng bày kèm màn hình hiển thị sản phẩm
        function createPedestalMesh({ isEmptySlot, product, zoneMeta, title, subtitle }) {
            const group = new THREE.Group();

            // 1. Chân đế bục 3D
            const baseMat = new THREE.MeshStandardMaterial({
                color: 0x0f172a,
                metalness: 0.75,
                roughness: 0.25
            });
            const pedestal = new THREE.Mesh(new THREE.BoxGeometry(2.6, 1.35, 1.1), baseMat);
            pedestal.position.y = 0.675;
            pedestal.castShadow = true;
            pedestal.receiveShadow = true;
            group.add(pedestal);

            // Viền LED quanh bục theo màu phân khu
            const ledStrip = new THREE.Mesh(
                new THREE.BoxGeometry(2.68, 0.08, 1.18),
                new THREE.MeshBasicMaterial({ color: zoneMeta.hex })
            );
            ledStrip.position.y = 1.32;
            group.add(ledStrip);

            // 2. Khung màn hình hiển thị phía trên bục
            const frameMat = new THREE.MeshStandardMaterial({
                color: 0x1e293b,
                metalness: 0.85,
                roughness: 0.2
            });
            const frame = new THREE.Mesh(new THREE.BoxGeometry(3.1, 2.1, 0.16), frameMat);
            frame.position.set(0, 2.65, 0);
            group.add(frame);

            // Viền phát sáng màn hình (Sẽ sáng rực khi rê chuột vào)
            const glowBorderMat = new THREE.MeshBasicMaterial({
                color: isEmptySlot ? 0x334155 : zoneMeta.hex
            });
            const glowBorder = new THREE.Mesh(new THREE.BoxGeometry(3.22, 2.22, 0.12), glowBorderMat);
            glowBorder.position.set(0, 2.65, -0.01);
            group.add(glowBorder);

            // 3. Mặt màn hình hiển thị nội dung / hình ảnh
            const screenTex = createTextTexture({
                width: 800,
                height: 520,
                bgColor: isEmptySlot ? '#070d19' : '#0b1730',
                borderColor: isEmptySlot ? '#475569' : zoneMeta.color,
                badge: isEmptySlot ? 'VỊ TRÍ TRỐNG' : zoneMeta.shortName,
                title: title,
                subtitle: isEmptySlot ? subtitle : (subtitle.length > 85 ? subtitle.substring(0, 82) + '...' : subtitle),
                titleSize: isEmptySlot ? 34 : 40,
                subtitleSize: 22
            });

            const screenMat = new THREE.MeshBasicMaterial({ map: screenTex });
            const screenMesh = new THREE.Mesh(new THREE.PlaneGeometry(2.96, 1.96), screenMat);
            screenMesh.position.set(0, 2.65, 0.09);
            group.add(screenMesh);

            // Nếu sản phẩm có URL hình ảnh đại diện -> Tải ảnh đắp lên nửa trên màn hình (có xử lý lỗi)
            if (!isEmptySlot && product && product.image) {
                const imgLoader = new THREE.TextureLoader();
                imgLoader.setCrossOrigin('anonymous');
                imgLoader.load(
                    product.image,
                    (loadedTex) => {
                        // Vẽ kết hợp ảnh sản phẩm + tên sản phẩm lên Canvas Texture
                        const img = loadedTex.image;
                        const c = document.createElement('canvas');
                        c.width = 800; c.height = 520;
                        const ctx = c.getContext('2d');

                        ctx.fillStyle = '#071024';
                        ctx.fillRect(0, 0, 800, 520);

                        // Vẽ ảnh sản phẩm ở phần trên
                        ctx.drawImage(img, 20, 20, 760, 340);

                        // Thanh tiêu đề bên dưới ảnh
                        ctx.fillStyle = 'rgba(7, 16, 36, 0.94)';
                        ctx.fillRect(20, 360, 760, 140);

                        ctx.strokeStyle = zoneMeta.color;
                        ctx.lineWidth = 6;
                        ctx.strokeRect(16, 16, 768, 488);

                        ctx.fillStyle = '#ffffff';
                        ctx.font = 'bold 32px Inter, sans-serif';
                        ctx.textAlign = 'center';
                        ctx.fillText(product.name.substring(0, 36), 400, 415);

                        ctx.fillStyle = zoneMeta.color;
                        ctx.font = '600 20px Inter, sans-serif';
                        ctx.fillText(`Nhấn để ${zoneMeta.actionLabel || 'XEM CHI TIẾT'}`, 400, 462);

                        const combinedTex = new THREE.CanvasTexture(c);
                        screenMesh.material.map = combinedTex;
                        screenMesh.material.needsUpdate = true;
                    },
                    undefined,
                    () => {
                        // Xử lý lỗi khi ảnh không tải được: giữ nguyên texture chữ mặc định rất rõ nét
                        console.warn('Không thể tải texture ảnh 3D cho sản phẩm:', product.name);
                    }
                );
            }
            // Đăng ký vật thể tương tác cho cả sản phẩm thực tế lẫn bục trống
            screenMesh.userData = {
                isProduct: !isEmptySlot,
                isEmptySlot: Boolean(isEmptySlot),
                zoneKey: zoneMeta.id,
                zoneName: zoneMeta.name,
                product: product || null,
                glowBorder: glowBorder,
                defaultColor: isEmptySlot ? 0x334155 : zoneMeta.hex
            };
            interactiveMeshes.push(screenMesh);

            return group;
        }

        // --- 5. HỆ THỐNG ĐIỀU KHIỂN 360°, DI CHUYỂN & MINI MAP ---
        function setupControls() {
            const domElement = renderer.domElement;

            // Biến theo dõi thao tác kéo chuột / vuốt cảm ứng xoay 360 độ
            let isDragging = false;
            let dragMoved = false;
            let prevX = 0;
            let prevY = 0;

            // --- SỰ KIỆN CHUỘT (DESKTOP) ---
            domElement.addEventListener('mousedown', (e) => {
                isDragging = true;
                dragMoved = false;
                prevX = e.clientX;
                prevY = e.clientY;
            });

            window.addEventListener('mousemove', (e) => {
                // Cập nhật tọa độ Raycaster để highlight sản phẩm khi rê chuột
                mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
                mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
                updateHoverTooltipPos(e.clientX, e.clientY);

                if (!isDragging) return;
                const dx = e.clientX - prevX;
                const dy = e.clientY - prevY;
                if (Math.abs(dx) > 3 || Math.abs(dy) > 3) dragMoved = true;

                prevX = e.clientX;
                prevY = e.clientY;

                // Thoát chế độ toàn cảnh nếu người dùng tự xoay góc nhìn
                if (playerState.isOverview) playerState.isOverview = false;
                playerState.targetPos = null;

                playerState.yaw -= dx * 0.0042;
                playerState.pitch = Math.max(-Math.PI / 3, Math.min(Math.PI / 3, playerState.pitch - dy * 0.0042));
            });

            window.addEventListener('mouseup', (e) => {
                if (isDragging && !dragMoved) {
                    // Nếu chỉ click (không kéo) -> Kiểm tra nhấn vào sản phẩm 3D
                    handleSceneClick(e.clientX, e.clientY);
                }
                isDragging = false;
            });

            // Con lăn chuột để phóng to / thu nhỏ
            domElement.addEventListener('wheel', (e) => {
                e.preventDefault();
                adjustZoom(e.deltaY > 0 ? 4 : -4);
            }, { passive: false });

            // --- SỰ KIỆN CẢM ỨNG (ĐIỆN THOẠI & MÁY TÍNH BẢNG) ---
            domElement.addEventListener('touchstart', (e) => {
                if (e.touches.length === 1) {
                    isDragging = true;
                    dragMoved = false;
                    prevX = e.touches[0].clientX;
                    prevY = e.touches[0].clientY;
                }
            }, { passive: true });

            domElement.addEventListener('touchmove', (e) => {
                if (isDragging && e.touches.length === 1) {
                    const dx = e.touches[0].clientX - prevX;
                    const dy = e.touches[0].clientY - prevY;
                    if (Math.abs(dx) > 4 || Math.abs(dy) > 4) dragMoved = true;

                    prevX = e.touches[0].clientX;
                    prevY = e.touches[0].clientY;

                    if (playerState.isOverview) playerState.isOverview = false;
                    playerState.targetPos = null;

                    playerState.yaw -= dx * 0.0055;
                    playerState.pitch = Math.max(-Math.PI / 3, Math.min(Math.PI / 3, playerState.pitch - dy * 0.0055));
                }
            }, { passive: true });

            domElement.addEventListener('touchend', (e) => {
                if (isDragging && !dragMoved && e.changedTouches.length > 0) {
                    const t = e.changedTouches[0];
                    handleSceneClick(t.clientX, t.clientY);
                }
                isDragging = false;
            });

            // --- BÀN PHÍM (W A S D & MŨI TÊN) ---
            window.addEventListener('keydown', (e) => {
                // Không bắt phím di chuyển khi đang nhập liệu trong Form quản trị
                if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) return;

                switch (e.code) {
                    case 'KeyW':
                    case 'ArrowUp':
                        moveInput.forward = true; break;
                    case 'KeyS':
                    case 'ArrowDown':
                        moveInput.backward = true; break;
                    case 'KeyA':
                    case 'ArrowLeft':
                        moveInput.left = true; break;
                    case 'KeyD':
                    case 'ArrowRight':
                        moveInput.right = true; break;
                }
            });

            window.addEventListener('keyup', (e) => {
                switch (e.code) {
                    case 'KeyW':
                    case 'ArrowUp':
                        moveInput.forward = false; break;
                    case 'KeyS':
                    case 'ArrowDown':
                        moveInput.backward = false; break;
                    case 'KeyA':
                    case 'ArrowLeft':
                        moveInput.left = false; break;
                    case 'KeyD':
                    case 'ArrowRight':
                        moveInput.right = false; break;
                }
            });

            // --- CÁC NÚT ĐIỀU HƯỚNG D-PAD TRÊN MÀN HÌNH ---
            const bindHoldButton = (btnId, directionKey) => {
                const btn = document.getElementById(btnId);
                if (!btn) return;
                const startMove = (e) => { e.preventDefault(); moveInput[directionKey] = true; };
                const stopMove = () => { moveInput[directionKey] = false; };

                btn.addEventListener('mousedown', startMove);
                btn.addEventListener('mouseup', stopMove);
                btn.addEventListener('mouseleave', stopMove);
                btn.addEventListener('touchstart', startMove, { passive: false });
                btn.addEventListener('touchend', stopMove);
            };

            bindHoldButton('move-forward', 'forward');
            bindHoldButton('move-backward', 'backward');
            bindHoldButton('move-left', 'left');
            bindHoldButton('move-right', 'right');

            // --- NÚT ZOOM IN / OUT ---
            document.getElementById('btn-zoom-in').addEventListener('click', () => {
                playSoundEffect('click');
                adjustZoom(-6);
            });
            document.getElementById('btn-zoom-out').addEventListener('click', () => {
                playSoundEffect('click');
                adjustZoom(6);
            });

            // --- NÚT CHUYỂN KHU VỰC TRÊN MENU ---
            document.querySelectorAll('.zone-nav-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const zoneId = btn.getAttribute('data-zone');
                    teleportToZone(zoneId);
                });
            });

            // --- NÚT TOÀN CẢNH ---
            document.getElementById('btn-overview').addEventListener('click', () => {
                playSoundEffect('teleport');
                playerState.isOverview = true;
                playerState.targetPos = new THREE.Vector3(0, 16.5, 22);
                playerState.targetYaw = 0;
                playerState.targetPitch = -0.68;
                showToast('Đang quan sát toàn cảnh không gian triển lãm 3D');
            });

            // --- NÚT TRỞ VỀ VỊ TRÍ BAN ĐẦU ---
            document.getElementById('btn-reset-pos').addEventListener('click', () => {
                teleportToZone('reception');
                showToast('Đã trở về khu vực cổng chào ban đầu');
            });

            // --- NHẤN VÀO BẢN ĐỒ MINI MAP ĐỂ DI CHUYỂN NHANH ---
            const miniCanvas = document.getElementById('minimap-canvas');
            miniCanvas.addEventListener('click', (e) => {
                const rect = miniCanvas.getBoundingClientRect();
                const normX = ((e.clientX - rect.left) / rect.width) * 2 - 1; // -1..1
                const normZ = ((e.clientY - rect.top) / rect.height) * 2 - 1; // -1..1

                const worldX = Math.max(ROOM_BOUNDS.minX, Math.min(ROOM_BOUNDS.maxX, normX * 24));
                const worldZ = Math.max(ROOM_BOUNDS.minZ, Math.min(ROOM_BOUNDS.maxZ, normZ * 28));

                playerState.isOverview = false;
                playerState.targetPos = new THREE.Vector3(worldX, 2.2, worldZ);
                playSoundEffect('teleport');
            });

            // --- RESPONSIVE RESIZE ---
            window.addEventListener('resize', () => {
                if (!camera || !renderer) return;
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        }

        function adjustZoom(deltaFov) {
            playerState.fov = Math.max(32, Math.min(82, playerState.fov + deltaFov));
            camera.fov = playerState.fov;
            camera.updateProjectionMatrix();
        }

        // Dịch chuyển mượt tới một phân khu cụ thể
        function teleportToZone(zoneId) {
            const zone = EXHIBITION_ZONES[zoneId];
            if (!zone) return;

            playSoundEffect('teleport');
            playerState.isOverview = false;
            playerState.targetPos = new THREE.Vector3(zone.camPos.x, zone.camPos.y, zone.camPos.z);

            // Tính toán góc xoay hướng thẳng về phía khu vực trưng bày
            const dx = zone.lookAt.x - zone.camPos.x;
            const dz = zone.lookAt.z - zone.camPos.z;
            playerState.targetYaw = Math.atan2(-dx, -dz);
            playerState.targetPitch = 0;

            updateActiveZoneUI(zoneId);
        }

        function updateActiveZoneUI(zoneId) {
            document.querySelectorAll('.zone-nav-btn').forEach(btn => {
                if (btn.getAttribute('data-zone') === zoneId) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
            if (EXHIBITION_ZONES[zoneId]) {
                document.getElementById('current-zone-label').textContent = EXHIBITION_ZONES[zoneId].shortName;
            }
        }

        // Kiểm tra nhấn chuột vào sản phẩm hoặc bục trống trong không gian 3D
        function handleSceneClick(clientX, clientY) {
            mouse.x = (clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(clientY / window.innerHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(interactiveMeshes, false);

            if (intersects.length > 0) {
                const hit = intersects[0].object;
                if (hit.userData && hit.userData.isProduct) {
                    playSoundEffect('click');
                    openProductDetailModal(hit.userData.product);
                } else if (hit.userData && hit.userData.isEmptySlot) {
                    playSoundEffect('click');
                    openAdminWithZone(hit.userData.zoneKey);
                }
            }
        }

        function updateHoverTooltipPos(x, y) {
            const tooltip = document.getElementById('hover-tooltip');
            tooltip.style.left = `${x}px`;
            tooltip.style.top = `${y}px`;
        }

        // Cập nhật hiệu ứng làm nổi bật khi rê chuột qua bục sản phẩm
        function updateRaycasterHover() {
            if (!raycaster || !camera || interactiveMeshes.length === 0) return;

            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(interactiveMeshes, false);
            const tooltip = document.getElementById('hover-tooltip');

            if (intersects.length > 0) {
                const target = intersects[0].object;
                if (hoveredObject !== target) {
                    // Khôi phục vật thể cũ
                    if (hoveredObject && hoveredObject.userData.glowBorder) {
                        hoveredObject.userData.glowBorder.material.color.setHex(hoveredObject.userData.defaultColor);
                        hoveredObject.parent.scale.set(1, 1, 1);
                    }
                    hoveredObject = target;
                    // Làm nổi bật vật thể mới
                    if (hoveredObject.userData.glowBorder) {
                        hoveredObject.userData.glowBorder.material.color.setHex(0xffffff);
                        hoveredObject.parent.scale.set(1.04, 1.04, 1.04);
                    }
                    document.body.style.cursor = 'pointer';
                    const tooltipLabel = hoveredObject.userData.isEmptySlot
                        ? `Bục trống (${hoveredObject.userData.zoneName}) - Nhấn để thêm sản phẩm`
                        : `${hoveredObject.userData.product.name} (Nhấn để xem / chỉnh sửa)`;
                    document.getElementById('hover-tooltip-text').textContent = tooltipLabel;
                    tooltip.classList.remove('hidden');
                    playSoundEffect('hover');
                }
            } else {
                if (hoveredObject) {
                    if (hoveredObject.userData.glowBorder) {
                        hoveredObject.userData.glowBorder.material.color.setHex(hoveredObject.userData.defaultColor);
                        hoveredObject.parent.scale.set(1, 1, 1);
                    }
                    hoveredObject = null;
                    document.body.style.cursor = 'grab';
                    tooltip.classList.add('hidden');
                }
            }
        }

        // Vẽ bản đồ thu nhỏ (Mini Map) theo thời gian thực
        function renderMiniMap() {
            const canvas = document.getElementById('minimap-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;

            ctx.clearRect(0, 0, w, h);

            // Nền bản đồ
            ctx.fillStyle = '#060d1f';
            ctx.fillRect(0, 0, w, h);

            // Viền phòng
            ctx.strokeStyle = 'rgba(56, 189, 248, 0.35)';
            ctx.lineWidth = 2;
            ctx.strokeRect(4, 4, w - 8, h - 8);

            // Chuyển đổi tọa độ thế giới 3D sang tọa độ MiniMap
            const toMapX = (wx) => ((wx + 24) / 48) * (w - 16) + 8;
            const toMapY = (wz) => ((wz + 28) / 56) * (h - 16) + 8;

            // Vẽ các điểm khu vực
            Object.values(EXHIBITION_ZONES).forEach(z => {
                const mx = toMapX(z.mapPos.x);
                const mz = toMapY(z.mapPos.z);

                ctx.fillStyle = z.color;
                ctx.beginPath();
                ctx.arc(mx, mz, 5, 0, Math.PI * 2);
                ctx.fill();
            });

            // Vẽ biểu tượng trung tâm
            ctx.strokeStyle = '#a855f7';
            ctx.beginPath();
            ctx.arc(toMapX(0), toMapY(0), 6, 0, Math.PI * 2);
            ctx.stroke();

            // Vẽ vị trí & hướng nhìn của người tham quan
            const px = toMapX(playerState.pos.x);
            const pz = toMapY(playerState.pos.z);

            ctx.save();
            ctx.translate(px, pz);
            ctx.rotate(-playerState.yaw);

            // Hình nón tầm nhìn
            ctx.fillStyle = 'rgba(56, 189, 248, 0.35)';
            ctx.beginPath();
            ctx.moveTo(0, 0);
            ctx.lineTo(-10, -20);
            ctx.lineTo(10, -20);
            ctx.closePath();
            ctx.fill();

            // Chấm người dùng
            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(0, 0, 4, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }

        // Tự động nhận diện người dùng đang đứng gần khu vực nào
        function detectNearestZone() {
            if (playerState.isOverview) {
                document.getElementById('current-zone-label').textContent = 'Toàn Cảnh';
                return;
            }
            let closestId = 'reception';
            let minDist = Infinity;

            Object.values(EXHIBITION_ZONES).forEach(z => {
                const dx = playerState.pos.x - z.mapPos.x;
                const dz = playerState.pos.z - z.mapPos.z;
                const dist = Math.sqrt(dx * dx + dz * dz);
                if (dist < minDist) {
                    minDist = dist;
                    closestId = z.id;
                }
            });

            updateActiveZoneUI(closestId);
        }

        // Vòng lặp hoạt ảnh chính (Animation Loop)
        function animate() {
            requestAnimationFrame(animate);

            const moveSpeed = 0.22;
            const forwardVec = new THREE.Vector3(-Math.sin(playerState.yaw), 0, -Math.cos(playerState.yaw));
            const rightVec = new THREE.Vector3(Math.cos(playerState.yaw), 0, -Math.sin(playerState.yaw));

            let isMovingManually = false;

            if (moveInput.forward) {
                playerState.pos.addScaledVector(forwardVec, moveSpeed);
                isMovingManually = true;
            }
            if (moveInput.backward) {
                playerState.pos.addScaledVector(forwardVec, -moveSpeed);
                isMovingManually = true;
            }
            if (moveInput.left) {
                playerState.pos.addScaledVector(rightVec, -moveSpeed);
                isMovingManually = true;
            }
            if (moveInput.right) {
                playerState.pos.addScaledVector(rightVec, moveSpeed);
                isMovingManually = true;
            }

            if (isMovingManually) {
                playerState.targetPos = null;
                if (playerState.isOverview) {
                    playerState.isOverview = false;
                    playerState.pos.y = 2.2;
                    playerState.pitch = 0;
                }
            }

            // Dịch chuyển mượt khi chọn khu vực trên Menu hoặc MiniMap
            if (playerState.targetPos) {
                playerState.pos.lerp(playerState.targetPos, 0.08);
                if (playerState.targetYaw !== null) {
                    playerState.yaw += (playerState.targetYaw - playerState.yaw) * 0.08;
                }
                if (playerState.targetPitch !== null) {
                    playerState.pitch += (playerState.targetPitch - playerState.pitch) * 0.08;
                }
                if (playerState.pos.distanceTo(playerState.targetPos) < 0.08) {
                    playerState.targetPos = null;
                }
            }

            // Giới hạn không cho đi xuyên tường
            playerState.pos.x = Math.max(ROOM_BOUNDS.minX, Math.min(ROOM_BOUNDS.maxX, playerState.pos.x));
            playerState.pos.z = Math.max(ROOM_BOUNDS.minZ, Math.min(ROOM_BOUNDS.maxZ, playerState.pos.z));

            // Cập nhật vị trí và hướng Camera
            camera.position.copy(playerState.pos);
            const euler = new THREE.Euler(playerState.pitch, playerState.yaw, 0, 'YXZ');
            camera.quaternion.setFromEuler(euler);

            // Hoạt ảnh cho khối Hologram và các hạt ánh sáng
            animatedObjects.forEach(item => {
                if (item.type === 'spinY') {
                    item.mesh.rotation.y += item.speed;
                } else if (item.type === 'spinReverse') {
                    item.mesh.rotation.y -= item.speed;
                    item.mesh.rotation.x += item.speed * 0.5;
                } else if (item.type === 'orbit') {
                    item.mesh.rotation.z += item.speed;
                } else if (item.type === 'particles') {
                    item.mesh.rotation.y += 0.0006;
                }
            });

            updateRaycasterHover();
            detectNearestZone();
            renderMiniMap();

            renderer.render(scene, camera);
        }

        // --- 6. QUẢN LÝ MODAL CHI TIẾT SẢN PHẨM & HỆ THỐNG QUẢN TRỊ (CMS) ---
        let currentViewingProduct = null;

        function openProductDetailModal(product) {
            currentViewingProduct = product;
            const modal = document.getElementById('product-detail-modal');
            const zoneMeta = EXHIBITION_ZONES[product.zone] || EXHIBITION_ZONES.ai_apps;

            document.getElementById('detail-zone-badge').textContent = zoneMeta.name;
            document.getElementById('detail-title').textContent = product.name;
            document.getElementById('detail-desc').textContent = product.desc;

            const imgEl = document.getElementById('detail-image');
            if (product.image) {
                imgEl.src = product.image;
            } else {
                imgEl.src = `https://placehold.co/800x450/0b1730/38bdf8?text=${encodeURIComponent(product.name)}`;
            }

            const launchBtn = document.getElementById('btn-launch-product');
            const launchText = document.getElementById('btn-launch-text');
            const noLinkNotice = document.getElementById('detail-no-link-notice');

            launchText.textContent = zoneMeta.actionLabel || 'XEM CHI TIẾT';

            if (product.link && product.link.trim() !== '') {
                launchBtn.href = product.link;
                launchBtn.classList.remove('opacity-50', 'pointer-events-none');
                noLinkNotice.classList.add('hidden');
            } else {
                launchBtn.href = '#';
                launchBtn.classList.add('opacity-50', 'pointer-events-none');
                noLinkNotice.classList.remove('hidden');
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeProductDetailModal() {
            currentViewingProduct = null;
            const modal = document.getElementById('product-detail-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            playSoundEffect('click');
        }

        // Mở bảng quản trị và chọn sẵn phân khu của bục đang nhấn
        function openAdminWithZone(zoneKey) {
            resetAdminForm();
            if (zoneKey && document.querySelector(`#prod-zone option[value="${zoneKey}"]`)) {
                document.getElementById('prod-zone').value = zoneKey;
                document.getElementById('filter-admin-zone').value = zoneKey;
            }
            renderAdminProductList();
            const m = document.getElementById('admin-modal');
            m.classList.remove('hidden');
            m.classList.add('flex');
            setTimeout(() => document.getElementById('prod-name').focus(), 100);
        }

        // Render danh sách sản phẩm trong trang Quản trị
        function renderAdminProductList() {
            const listContainer = document.getElementById('admin-product-list');
            const emptyState = document.getElementById('admin-empty-state');
            const filterZone = document.getElementById('filter-admin-zone').value;
            const totalCountEl = document.getElementById('total-prod-count');

            totalCountEl.textContent = products.length;

            const filtered = filterZone === 'all'
                ? products
                : products.filter(p => p.zone === filterZone);

            if (filtered.length === 0) {
                emptyState.classList.remove('hidden');
                listContainer.classList.add('hidden');
                listContainer.innerHTML = '';
                return;
            }

            emptyState.classList.add('hidden');
            listContainer.classList.remove('hidden');
            listContainer.innerHTML = '';

            filtered.forEach((prod, index) => {
                const zoneMeta = EXHIBITION_ZONES[prod.zone];
                const globalIndex = products.findIndex(p => p.id === prod.id);

                const card = document.createElement('div');
                card.className = 'p-3.5 rounded-2xl bg-slate-900/90 border border-slate-700/80 flex items-center justify-between gap-3 hover:border-cyan-500/40 transition-colors';

                card.innerHTML = `
                    <div class="flex items-center gap-3 min-w-0">
                        <img src="${prod.image || 'https://placehold.co/120x120/0f172a/38bdf8?text=AI'}" 
                             alt="${prod.name}" 
                             class="w-14 h-14 rounded-xl object-cover bg-slate-950 border border-slate-700 shrink-0"
                             onerror="this.src='https://placehold.co/120x120/0f172a/38bdf8?text=AI'">
                        <div class="min-w-0">
                            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-800 text-cyan-300 mb-1">
                                ${zoneMeta ? zoneMeta.name : prod.zone}
                            </span>
                            <h5 class="text-sm font-bold text-white truncate">${prod.name}</h5>
                            <p class="text-xs text-slate-400 truncate">${prod.desc}</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-1 shrink-0">
                        <button onclick="moveProductOrder(${globalIndex}, -1)" title="Đưa lên trước" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center text-xs cursor-pointer">
                            <i class="fa-solid fa-arrow-up"></i>
                        </button>
                        <button onclick="moveProductOrder(${globalIndex}, 1)" title="Đưa xuống sau" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center text-xs cursor-pointer">
                            <i class="fa-solid fa-arrow-down"></i>
                        </button>
                        <button onclick="editProduct('${prod.id}')" title="Chỉnh sửa" class="w-8 h-8 rounded-lg bg-blue-500/20 hover:bg-blue-500/30 text-blue-300 flex items-center justify-center text-xs cursor-pointer">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button onclick="deleteProduct('${prod.id}')" title="Xóa sản phẩm" class="w-8 h-8 rounded-lg bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 flex items-center justify-center text-xs cursor-pointer">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                `;
                listContainer.appendChild(card);
            });
        }

        // Sắp xếp thứ tự trưng bày
        window.moveProductOrder = function(index, direction) {
            const newIndex = index + direction;
            if (newIndex < 0 || newIndex >= products.length) return;
            const temp = products[index];
            products[index] = products[newIndex];
            products[newIndex] = temp;

            saveProductsToStorage();
            renderAdminProductList();
            rebuildProductDisplays();
            playSoundEffect('click');
            showToast('Đã cập nhật thứ tự trưng bày trên kệ 3D', 'success');
        };

        // Nạp dữ liệu lên Form để chỉnh sửa
        window.editProduct = function(id) {
            const prod = products.find(p => p.id === id);
            if (!prod) return;

            document.getElementById('prod-id').value = prod.id;
            document.getElementById('prod-zone').value = prod.zone;
            document.getElementById('prod-name').value = prod.name;
            document.getElementById('prod-desc').value = prod.desc;
            document.getElementById('prod-img-url').value = prod.image || '';
            document.getElementById('prod-link').value = prod.link || '';

            document.getElementById('form-mode-title').innerHTML = '<i class="fa-solid fa-pen-to-square"></i> Chỉnh sửa sản phẩm';
            document.getElementById('btn-cancel-edit').classList.remove('hidden');
            playSoundEffect('click');
        };

        // Xóa sản phẩm
        window.deleteProduct = function(id) {
            products = products.filter(p => p.id !== id);
            saveProductsToStorage();
            renderAdminProductList();
            rebuildProductDisplays();
            playSoundEffect('click');
            showToast('Đã xóa sản phẩm khỏi phòng trưng bày', 'info');
        };

        function resetAdminForm() {
            document.getElementById('product-form').reset();
            document.getElementById('prod-id').value = '';
            document.getElementById('file-upload-status').textContent = 'Chưa chọn tệp';
            document.getElementById('form-mode-title').innerHTML = '<i class="fa-solid fa-plus-circle"></i> Thêm sản phẩm mới';
            document.getElementById('btn-cancel-edit').classList.add('hidden');
        }

        // Khởi tạo toàn bộ sự kiện giao diện người dùng (UI)
        function setupUIEvents() {
            // 1. Nút BẮT ĐẦU THAM QUAN ở màn hình chào mừng
            document.getElementById('btn-start-tour').addEventListener('click', () => {
                initAudio();
                playSoundEffect('enter');

                const welcome = document.getElementById('welcome-overlay');
                const hud = document.getElementById('hud-interface');

                welcome.classList.add('opacity-0', 'pointer-events-none');
                setTimeout(() => {
                    welcome.style.display = 'none';
                }, 700);

                hud.classList.remove('opacity-0');
                teleportToZone('reception');
            });

            // 2. Bật / Tắt âm thanh
            document.getElementById('btn-toggle-audio').addEventListener('click', () => {
                audioEnabled = !audioEnabled;
                const icon = document.getElementById('icon-audio');
                if (audioEnabled) {
                    icon.className = 'fa-solid fa-volume-high';
                    playSoundEffect('click');
                    showToast('Đã bật âm thanh hiệu ứng');
                } else {
                    icon.className = 'fa-solid fa-volume-xmark text-slate-500';
                    showToast('Đã tắt âm thanh');
                }
            });

            // 3. Toàn màn hình
            document.getElementById('btn-fullscreen').addEventListener('click', () => {
                playSoundEffect('click');
                if (!document.fullscreenElement) {
                    document.documentElement.requestFullscreen().catch(() => {
                        showToast('Trình duyệt không hỗ trợ chế độ toàn màn hình ở khung này');
                    });
                } else {
                    document.exitFullscreen();
                }
            });

            // 4. Mở / Đóng Modal Hướng dẫn sử dụng
            document.getElementById('btn-help').addEventListener('click', () => {
                playSoundEffect('click');
                const m = document.getElementById('help-modal');
                m.classList.remove('hidden');
                m.classList.add('flex');
            });
            document.getElementById('btn-close-help').addEventListener('click', () => {
                playSoundEffect('click');
                const m = document.getElementById('help-modal');
                m.classList.add('hidden');
                m.classList.remove('flex');
            });

            // 5. Đóng Modal Chi Tiết Sản Phẩm & Nút Chỉnh Sửa Nhanh Tại Bục
            document.getElementById('btn-close-detail').addEventListener('click', closeProductDetailModal);
            document.getElementById('btn-back-to-space').addEventListener('click', closeProductDetailModal);
            document.getElementById('btn-edit-from-detail').addEventListener('click', () => {
                if (!currentViewingProduct) return;
                const prodToEdit = currentViewingProduct;
                closeProductDetailModal();

                document.getElementById('filter-admin-zone').value = prodToEdit.zone;
                renderAdminProductList();
                editProduct(prodToEdit.id);

                const m = document.getElementById('admin-modal');
                m.classList.remove('hidden');
                m.classList.add('flex');
            });

            // 6. Mở / Đóng Modal Quản Trị Sản Phẩm
            document.getElementById('btn-open-admin').addEventListener('click', () => {
                playSoundEffect('click');
                document.getElementById('filter-admin-zone').value = 'all';
                renderAdminProductList();
                const m = document.getElementById('admin-modal');
                m.classList.remove('hidden');
                m.classList.add('flex');
            });
            document.getElementById('btn-close-admin').addEventListener('click', () => {
                playSoundEffect('click');
                const m = document.getElementById('admin-modal');
                m.classList.add('hidden');
                m.classList.remove('flex');
                resetAdminForm();
            });

            document.getElementById('btn-cancel-edit').addEventListener('click', () => {
                playSoundEffect('click');
                resetAdminForm();
            });

            document.getElementById('filter-admin-zone').addEventListener('change', renderAdminProductList);

            // Xử lý tải ảnh từ máy tính trong Form Quản trị
            document.getElementById('prod-img-file').addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (!file) return;
                document.getElementById('file-upload-status').textContent = file.name;

                const reader = new FileReader();
                reader.onload = function(evt) {
                    document.getElementById('prod-img-url').value = evt.target.result;
                };
                reader.readAsDataURL(file);
            });

            // Xử lý lưu sản phẩm (Thêm mới hoặc Cập nhật)
            document.getElementById('product-form').addEventListener('submit', (e) => {
                e.preventDefault();

                const id = document.getElementById('prod-id').value;
                const zone = document.getElementById('prod-zone').value;
                const name = document.getElementById('prod-name').value.trim();
                const desc = document.getElementById('prod-desc').value.trim();
                const image = document.getElementById('prod-img-url').value.trim();
                const link = document.getElementById('prod-link').value.trim();

                if (!name || !desc) {
                    showToast('Vui lòng nhập đầy đủ tên và mô tả sản phẩm!', 'error');
                    return;
                }

                if (id) {
                    // Cập nhật sản phẩm đang sửa
                    const idx = products.findIndex(p => p.id === id);
                    if (idx !== -1) {
                        products[idx] = { ...products[idx], zone, name, desc, image, link };
                        showToast('Đã cập nhật thông tin sản phẩm lên bục 3D!', 'success');
                    }
                } else {
                    // Thêm sản phẩm mới
                    const newProd = {
                        id: 'prod_' + Date.now(),
                        zone,
                        name,
                        desc,
                        image,
                        link,
                        createdAt: new Date().toISOString()
                    };
                    products.push(newProd);
                    showToast('Đã thêm sản phẩm mới vào phòng trưng bày 3D!', 'success');
                }

                saveProductsToStorage();
                renderAdminProductList();
                rebuildProductDisplays();
                resetAdminForm();
                playSoundEffect('enter');
            });
        }

        // --- KHỞI CHẠY ỨNG DỤNG KHI TẢI XONG TRANG ---
        window.onload = function() {
            loadProductsFromStorage();
            setupUIEvents();
            init3DScene();
            animate();
        };
    </script>
</body>
</html>