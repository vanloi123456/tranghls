    <!-- MÃ NGUỒN JAVASCRIPT XỬ LÝ KHÔNG GIAN 3D, ÂM THANH & QUẢN TRỊ -->
    <script>
        /**
         * ============================================================================
         * PHÒNG TRƯNG BÀY SẢN PHẨM GIÁO DỤC SỐ ỨNG DỤNG AI
         * Kiến trúc ứng dụng:
         * 1. State & Storage Manager: Quản lý dữ liệu sản phẩm (mặc định trống hoàn toàn).
         * 2. Sound Synthesizer (Tone.js): Tạo âm thanh phản hồi không gian tinh tế.
         * 3. 3D Exhibition Engine (Three.js): Dựng kiến trúc phòng triển lãm, ánh sáng,
         *    sàn phản chiếu, cổng chào, 5 khu trưng bày và bục sản phẩm động.
         * 4. Navigation & MiniMap Controller: Điều khiển góc nhìn 360, di chuyển mượt,
         *    va chạm tường và bản đồ định vị trực quan.
         * 5. Admin CMS & UI Controller: Xử lý thêm/sửa/xóa/sắp xếp và hiển thị chi tiết.
         * ============================================================================
         */

        // --- 1. CẤU HÌNH KHU VỰC TRIỂN LÃM & DỮ LIỆU ---
        const STORAGE_KEY = 'ai_edu_3d_exhibition_products_v1';

        // Định nghĩa tọa độ 3D và thông tin 6 khu vực trong phòng triển lãm
        const EXHIBITION_ZONES = {
            reception: {
                id: 'reception',
                name: '1. Khu Đón Tiếp',
                shortName: 'Đón Tiếp',
                color: '#38bdf8', // Cyan
                hex: 0x38bdf8,
                camPos: { x: 0, y: 2.2, z: 24 },
                lookAt: { x: 0, y: 2.2, z: 10 },
                mapPos: { x: 0, z: 22 }
            },
            ai_apps: {
                id: 'ai_apps',
                name: '2. Khu Ứng Dụng AI',
                shortName: 'Ứng Dụng AI',
                actionLabel: 'XEM CHI TIẾT',
                color: '#3b82f6', // Blue
                hex: 0x3b82f6,
                camPos: { x: -8, y: 2.2, z: 8 },
                lookAt: { x: -18, y: 2.0, z: 8 },
                mapPos: { x: -16, z: 8 }
            },
            games: {
                id: 'games',
                name: '3. Khu Trò Chơi Tương Tác',
                shortName: 'Trò Chơi',
                actionLabel: 'CHƠI NGAY',
                color: '#a855f7', // Purple
                hex: 0xa855f7,
                camPos: { x: 8, y: 2.2, z: 8 },
                lookAt: { x: 18, y: 2.0, z: 8 },
                mapPos: { x: 16, z: 8 }
            },
            materials: {
                id: 'materials',
                name: '4. Khu Học Liệu Số',
                shortName: 'Học Liệu Số',
                actionLabel: 'MỞ HỌC LIỆU',
                color: '#10b981', // Emerald
                hex: 0x10b981,
                camPos: { x: -8, y: 2.2, z: -8 },
                lookAt: { x: -18, y: 2.0, z: -8 },
                mapPos: { x: -16, z: -8 }
            },
            experiments: {
                id: 'experiments',
                name: '5. Khu Thí Nghiệm & Mô Phỏng 3D',
                shortName: 'Thí Nghiệm 3D',
                actionLabel: 'TRẢI NGHIỆM 3D',
                color: '#f59e0b', // Amber
                hex: 0xf59e0b,
                camPos: { x: 8, y: 2.2, z: -8 },
                lookAt: { x: 18, y: 2.0, z: -8 },
                mapPos: { x: 16, z: -8 }
            },
            creative: {
                id: 'creative',
                name: '6. Khu Sản Phẩm Sáng Tạo',
                shortName: 'Sáng Tạo',
                actionLabel: 'KHÁM PHÁ',
                color: '#ec4899', // Pink
                hex: 0xec4899,
                camPos: { x: 0, y: 2.2, z: -13 },
                lookAt: { x: 0, y: 2.2, z: -24 },
                mapPos: { x: 0, z: -22 }
            }
        };

        // Danh sách sản phẩm (Khởi tạo trống hoàn toàn theo đúng yêu cầu)
        let products = [];

        // Tải dữ liệu do người quản trị đã lưu trước đó (nếu có)
        function loadProductsFromStorage() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    if (Array.isArray(parsed)) {
                        products = parsed;
                    }
                }
            } catch (err) {
                console.error('Lỗi đọc dữ liệu lưu trữ:', err);
                products = [];
            }
        }

        function saveProductsToStorage() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(products));
            } catch (err) {
                showToast('Bộ nhớ trình duyệt đầy, hãy dùng link ảnh thay vì tải tệp quá lớn!', 'error');
            }
        }

        // --- 2. HỆ THỐNG ÂM THANH TƯƠNG TÁC (TONE.JS) ---
        let audioEnabled = true;
        let synth = null;

        function initAudio() {
            try {
                if (typeof Tone !== 'undefined' && !synth) {
                    synth = new Tone.PolySynth(Tone.Synth, {
                        oscillator: { type: 'sine' },
                        envelope: { attack: 0.02, decay: 0.15, sustain: 0.05, release: 0.4 }
                    }).toDestination();
                    synth.volume.value = -14;
                }
            } catch (e) {
                console.warn('Trình duyệt chưa kích hoạt âm thanh:', e);
            }
        }

        function playSoundEffect(type) {
            if (!audioEnabled || typeof Tone === 'undefined') return;
            try {
                if (Tone.context.state !== 'running') {
                    Tone.start();
                }
                if (!synth) initAudio();
                if (!synth) return;

                if (type === 'click') {
                    synth.triggerAttackRelease('C5', '32n');
                } else if (type === 'enter') {
                    synth.triggerAttackRelease(['C4', 'E4', 'G4', 'B4'], '8n');
                } else if (type === 'hover') {
                    synth.triggerAttackRelease('G5', '64n');
                } else if (type === 'teleport') {
                    synth.triggerAttackRelease(['D4', 'A4'], '16n');
                }
            } catch (e) {
                // Bỏ qua lỗi âm thanh nếu người dùng chưa tương tác
            }
        }

        // Hàm hiển thị thông báo thay thế alert()
        let toastTimeout = null;
        function showToast(msg, type = 'info') {
            const box = document.getElementById('toast-box');
            const text = document.getElementById('toast-message');
            const icon = document.getElementById('toast-icon');

            text.textContent = msg;
            if (type === 'error') {
                icon.className = 'fa-solid fa-circle-exclamation text-rose-400';
            } else if (type === 'success') {
                icon.className = 'fa-solid fa-circle-check text-emerald-400';
            } else {
                icon.className = 'fa-solid fa-circle-info text-cyan-400';
            }

            box.classList.remove('opacity-0', 'translate-y-[-10px]');
            box.classList.add('opacity-100', 'translate-y-0');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                box.classList.remove('opacity-100', 'translate-y-0');
                box.classList.add('opacity-0', 'translate-y-[-10px]');
            }, 3000);
        }

        // --- 3. KHỞI TẠO KHÔNG GIAN 3D THREE.JS ---
        let scene, camera, renderer, raycaster, mouse;
        // Nhóm sản phẩm động
        let dynamicProductGroup = null; // Nhóm chứa các bục sản phẩm được tạo động
        let dynamicCarpetGroup = null;  // Nhóm chứa thảm sáng tự động co giãn theo số lượng sản phẩm
        let interactiveMeshes = [];     // Danh sách các màn hình bục trưng bày có thể tương tác
        let animatedObjects = [];       // Các vật thể trang trí chuyển động (vòng hologram, hạt ánh sáng...)
        let hoveredObject = null;

        // Trạng thái điều khiển Camera & Di chuyển
        const playerState = {
            pos: new THREE.Vector3(0, 2.2, 26),
            yaw: 0,       // Góc xoay ngang (radian)
            pitch: 0,     // Góc ngẩng/cúi (radian)
            fov: 60,
            isOverview: false,
            targetPos: null,
            targetYaw: null,
            targetPitch: null
        };

        // Trạng thái phím bấm & nút điều hướng
        const moveInput = {
            forward: false,
            backward: false,
            left: false,
            right: false
        };

        // Giới hạn không gian phòng (m)
        const ROOM_BOUNDS = {
            minX: -22.5,
            maxX: 22.5,
            minZ: -25.5,
            maxZ: 26.5
        };

        // Hàm tạo Texture chữ / bảng hiệu chất lượng cao bằng HTML5 Canvas
        function createTextTexture(options) {
            const {
                width = 1024,
                height = 512,
                bgColor = '#091326',
                borderColor = '#38bdf8',
                title = '',
                subtitle = '',
                badge = '',
                titleColor = '#ffffff',
                subtitleColor = '#7dd3fc',
                titleSize = 54,
                subtitleSize = 28
            } = options;

            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');

            // Nền gradient công nghệ
            const grad = ctx.createLinearGradient(0, 0, width, height);
            grad.addColorStop(0, bgColor);
            grad.addColorStop(1, '#030712');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, width, height);

            // Lưới công nghệ mờ
            ctx.strokeStyle = 'rgba(56, 189, 248, 0.08)';
            ctx.lineWidth = 2;
            for (let x = 0; x < width; x += 64) {
                ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke();
            }
            for (let y = 0; y < height; y += 64) {
                ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke();
            }

            // Viền phát sáng
            ctx.strokeStyle = borderColor;
            ctx.lineWidth = 10;
            ctx.strokeRect(14, 14, width - 28, height - 28);

            // Góc trang trí
            ctx.fillStyle = borderColor;
            ctx.fillRect(14, 14, 60, 16);
            ctx.fillRect(width - 74, height - 30, 60, 16);

            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';

            let centerY = height / 2;

            if (badge) {
                ctx.font = 'bold 24px Inter, sans-serif';
                ctx.fillStyle = borderColor;
                ctx.fillText(badge.toUpperCase(), width / 2, centerY - 95);
            }

            if (title) {
                ctx.font = `800 ${titleSize}px Inter, sans-serif`;
                ctx.fillStyle = titleColor;
                ctx.shadowColor = borderColor;
                ctx.shadowBlur = 18;
                wrapCanvasText(ctx, title, width / 2, subtitle ? centerY - 15 : centerY, width - 100, titleSize * 1.25);
                ctx.shadowBlur = 0;
            }

            if (subtitle) {
                ctx.font = `500 ${subtitleSize}px Inter, sans-serif`;
                ctx.fillStyle = subtitleColor;
                wrapCanvasText(ctx, subtitle, width / 2, centerY + 85, width - 120, subtitleSize * 1.3);
            }

            const texture = new THREE.CanvasTexture(canvas);
            texture.anisotropy = 4;
            return texture;
        }

        function wrapCanvasText(ctx, text, x, y, maxWidth, lineHeight) {
            const words = text.split(' ');
            let line = '';
            const lines = [];

            for (let n = 0; n < words.length; n++) {
                const testLine = line + words[n] + ' ';
                const metrics = ctx.measureText(testLine);
                if (metrics.width > maxWidth && n > 0) {
                    lines.push(line.trim());
                    line = words[n] + ' ';
                } else {
                    line = testLine;
                }
            }
            lines.push(line.trim());

            const startY = y - ((lines.length - 1) * lineHeight) / 2;
            lines.forEach((l, i) => {
                ctx.fillText(l, x, startY + i * lineHeight);
            });
        }

