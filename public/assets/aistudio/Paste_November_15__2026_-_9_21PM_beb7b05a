<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PHÒNG TRƯNG BÀY SẢN PHẨM GIÁO DỤC SỐ ỨNG DỤNG AI</title>
    
    <!-- Khai báo thư viện ngoài (Yêu cầu kết nối Internet để tải CDN) -->
    <!-- Tailwind CSS cho giao diện UI hiện đại -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font chữ Inter hỗ trợ tiếng Việt sắc nét -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Three.js r128 cho đồ họa không gian 3D thực tế -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Tone.js cho hiệu ứng âm thanh tương tác không gian (không dùng link âm thanh ngoài) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- FontAwesome Icons cho biểu tượng trực quan -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* Thiết lập cơ bản và ngăn cuộn trang ngoài ý muốn */
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            font-family: 'Inter', sans-serif;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #030712; /* Nền tối sâu công nghệ */
            color: #f8fafc;
        }

        /* Canvas 3D chiếm toàn bộ màn hình */
        #canvas-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 1;
            touch-action: none; /* Tối ưu thao tác vuốt 3D trên cảm ứng */
        }

        /* Hiệu ứng kính mờ (Glassmorphism) phong cách Futuristic */
        .glass-panel {
            background: rgba(10, 18, 36, 0.78);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(56, 189, 248, 0.28);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), inset 0 0 15px rgba(56, 189, 248, 0.08);
        }

        .glass-btn {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(56, 189, 248, 0.35);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-btn:hover, .glass-btn:active {
            background: rgba(14, 165, 233, 0.25);
            border-color: #38bdf8;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.45);
            transform: translateY(-1px);
        }
        .glass-btn.active {
            background: linear-gradient(135deg, rgba(2, 132, 199, 0.6), rgba(124, 58, 237, 0.6));
            border-color: #7dd3fc;
            box-shadow: 0 0 18px rgba(56, 189, 248, 0.6);
        }

        /* Thanh cuộn tùy chỉnh cho Modal và Bảng quản trị */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.5);
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(56, 189, 248, 0.4);
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(56, 189, 248, 0.7);
        }

        /* Hiệu ứng phát sáng chữ tiêu đề */
        .neon-text {
            text-shadow: 0 0 12px rgba(56, 189, 248, 0.7), 0 0 24px rgba(139, 92, 246, 0.4);
        }

        /* Animation nhẹ cho điểm chỉ báo trên MiniMap */
        @keyframes pulse-ring {
            0% { transform: scale(0.8); opacity: 0.9; }
            100% { transform: scale(2.2); opacity: 0; }
        }
        .pulse-dot::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px solid #38bdf8;
            animation: pulse-ring 1.5s infinite;
        }
    </style>
</head>
<body>

    <!-- Vùng chứa không gian 3D Three.js -->
    <div id="canvas-container"></div>

    <!-- MÀN HÌNH CHÀO MỪNG / CỔNG VÀO TRIỂN LÃM -->
    <div id="welcome-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/85 backdrop-blur-md p-4 transition-opacity duration-700">
        <div class="glass-panel max-w-2xl w-full rounded-3xl p-6 sm:p-10 text-center relative overflow-hidden border-cyan-400/40">
            <!-- Trang trí góc công nghệ -->
            <div class="absolute top-0 left-0 w-24 h-24 bg-cyan-500/10 rounded-br-full pointer-events-none"></div>
            <div class="absolute bottom-0 right-0 w-32 h-32 bg-purple-600/10 rounded-tl-full pointer-events-none"></div>

            <!-- Logo Biểu Tượng AI Giáo Dục -->
            <div class="mx-auto w-20 h-20 rounded-2xl bg-gradient-to-br from-cyan-500 via-blue-600 to-purple-600 p-0.5 shadow-lg shadow-cyan-500/30 mb-5 flex items-center justify-center">
                <div class="w-full h-full bg-slate-950 rounded-2xl flex items-center justify-center">
                    <i class="fa-solid fa-atom text-3xl text-cyan-400 animate-spin" style="animation-duration: 12s;"></i>
                </div>
            </div>

            <div class="inline-block px-3 py-1 rounded-full bg-cyan-500/15 border border-cyan-400/30 text-cyan-300 text-xs font-semibold tracking-wider uppercase mb-3">
                Không Gian Triển Lãm Thực Tế Ảo 3D
            </div>

            <h1 class="text-2xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-white via-cyan-200 to-purple-300 neon-text leading-tight mb-3">
                PHÒNG TRƯNG BÀY SẢN PHẨM GIÁO DỤC SỐ ỨNG DỤNG AI
            </h1>

            <p class="text-sm sm:text-base font-medium text-cyan-300 tracking-widest uppercase mb-6">
                ✦ SÁNG TẠO – TRẢI NGHIỆM – KẾT NỐI TRI THỨC ✦
            </p>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8 max-w-xl mx-auto">
                Chào mừng quý thầy cô, các em học sinh và khách tham quan bước vào không gian triển lãm số tương tác 3D. Hãy tự do di chuyển, khám phá 5 phân khu trưng bày công nghệ giáo dục và tương tác trực tiếp với từng sản phẩm.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <button id="btn-start-tour" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-cyan-500 via-blue-600 to-purple-600 hover:from-cyan-400 hover:to-purple-500 text-white font-bold text-base sm:text-lg shadow-lg shadow-cyan-500/30 transition-all transform hover:scale-105 active:scale-95 flex items-center justify-center gap-3 cursor-pointer">
                    <i class="fa-solid fa-vr-cardboard text-xl"></i>
                    <span>BẮT ĐẦU THAM QUAN</span>
                </button>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-800/80 flex flex-wrap items-center justify-center gap-4 text-xs text-slate-400">
                <span><i class="fa-solid fa-wifi text-cyan-400 mr-1"></i> Yêu cầu kết nối Internet (Three.js & Tailwind CDN)</span>
                <span><i class="fa-solid fa-mobile-screen text-purple-400 mr-1"></i> Hỗ trợ Máy tính, Máy tính bảng & Điện thoại</span>
            </div>
        </div>
    </div>

    <!-- GIAO DIỆN ĐIỀU KHIỂN CHÍNH (HUD OVERLAY) -->
    <div id="hud-interface" class="fixed inset-0 z-10 pointer-events-none flex flex-col justify-between p-2 sm:p-4 opacity-0 transition-opacity duration-500">
        
        <!-- 1. THANH TIÊU ĐỀ & MENU PHÍA TRÊN -->
        <header class="w-full flex flex-col gap-2 pointer-events-auto">
            <div class="glass-panel rounded-2xl px-3 py-2 sm:px-5 sm:py-3 flex items-center justify-between gap-2">
                <!-- Logo & Tên Phòng Trưng Bày -->
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 to-purple-600 flex items-center justify-center shrink-0 shadow-md shadow-cyan-500/20">
                        <i class="fa-solid fa-cube text-white text-lg"></i>
                    </div>
                    <div class="min-w-0">
                        <h2 class="text-xs sm:text-sm md:text-base font-bold text-white truncate">
                            PHÒNG TRƯNG BÀY SẢN PHẨM GIÁO DỤC SỐ ỨNG DỤNG AI
                        </h2>
                        <p class="text-[10px] sm:text-xs text-cyan-300 truncate">
                            SÁNG TẠO – TRẢI NGHIỆM – KẾT NỐI TRI THỨC
                        </p>
                    </div>
                </div>

                <!-- Các nút chức năng hệ thống -->
                <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
                    <!-- Nút Quản Trị Sản Phẩm -->
                    <button id="btn-open-admin" title="Quản trị sản phẩm trưng bày" class="glass-btn px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold text-amber-300 border-amber-400/40 flex items-center gap-1.5 cursor-pointer">
                        <i class="fa-solid fa-sliders"></i>
                        <span class="hidden md:inline">Quản trị</span>
                    </button>

                    <!-- Nút Toàn Cảnh -->
                    <button id="btn-overview" title="Góc nhìn toàn cảnh từ trên cao" class="glass-btn px-3 py-2 rounded-xl text-xs sm:text-sm font-medium text-cyan-200 flex items-center gap-1.5 cursor-pointer">
                        <i class="fa-solid fa-eye"></i>
                        <span class="hidden lg:inline">Toàn cảnh</span>
                    </button>

                    <!-- Nút Trở Về Vị Trí Ban Đầu -->
                    <button id="btn-reset-pos" title="Trở về cổng chào ban đầu" class="glass-btn p-2 sm:px-3 sm:py-2 rounded-xl text-xs sm:text-sm text-slate-200 flex items-center gap-1.5 cursor-pointer">
                        <i class="fa-solid fa-house"></i>
                        <span class="hidden xl:inline">Ban đầu</span>
                    </button>

                    <!-- Nút Bật/Tắt Âm Thanh -->
                    <button id="btn-toggle-audio" title="Bật / Tắt âm thanh hiệu ứng" class="glass-btn p-2 rounded-xl text-cyan-300 cursor-pointer w-9 h-9 flex items-center justify-center">
                        <i id="icon-audio" class="fa-solid fa-volume-high"></i>
                    </button>

                    <!-- Nút Toàn Màn Hình -->
                    <button id="btn-fullscreen" title="Toàn màn hình" class="glass-btn p-2 rounded-xl text-slate-200 cursor-pointer w-9 h-9 flex items-center justify-center">
                        <i id="icon-fullscreen" class="fa-solid fa-expand"></i>
                    </button>

                    <!-- Nút Hướng Dẫn -->
                    <button id="btn-help" title="Hướng dẫn tham quan" class="glass-btn p-2 rounded-xl text-purple-300 cursor-pointer w-9 h-9 flex items-center justify-center">
                        <i class="fa-solid fa-circle-question"></i>
                    </button>
                </div>
            </div>

            <!-- Menu Điều Hướng Nhanh Các Khu Vực -->
            <nav class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto pb-1 no-scrollbar">
                <button data-zone="reception" class="zone-nav-btn glass-btn active px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap flex items-center gap-1.5 cursor-pointer">
                    <i class="fa-solid fa-door-open text-cyan-400"></i> 1. Đón Tiếp
                </button>
                <button data-zone="ai_apps" class="zone-nav-btn glass-btn px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap flex items-center gap-1.5 cursor-pointer">
                    <i class="fa-solid fa-robot text-blue-400"></i> 2. Ứng Dụng AI
                </button>
                <button data-zone="games" class="zone-nav-btn glass-btn px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap flex items-center gap-1.5 cursor-pointer">
                    <i class="fa-solid fa-gamepad text-purple-400"></i> 3. Trò Chơi Tương Tác
                </button>
                <button data-zone="materials" class="zone-nav-btn glass-btn px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap flex items-center gap-1.5 cursor-pointer">
                    <i class="fa-solid fa-book-open text-emerald-400"></i> 4. Học Liệu Số
                </button>
                <button data-zone="experiments" class="zone-nav-btn glass-btn px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap flex items-center gap-1.5 cursor-pointer">
                    <i class="fa-solid fa-flask text-amber-400"></i> 5. Thí Nghiệm 3D
                </button>
                <button data-zone="creative" class="zone-nav-btn glass-btn px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap flex items-center gap-1.5 cursor-pointer">
                    <i class="fa-solid fa-lightbulb text-pink-400"></i> 6. Sản Phẩm Sáng Tạo
                </button>
            </nav>
        </header>

        <!-- Nhãn thông báo khi rê chuột qua vật thể tương tác 3D -->
        <div id="hover-tooltip" class="fixed pointer-events-none z-30 hidden px-3 py-1.5 rounded-xl glass-panel border-cyan-400 text-xs font-semibold text-white shadow-lg transform -translate-x-1/2 -translate-y-full mt-[-12px]">
            <span id="hover-tooltip-text">Tên sản phẩm</span>
        </div>

        <!-- 2. THANH ĐIỀU KHIỂN DI CHUYỂN & MINI MAP PHÍA DƯỚI -->
        <footer class="w-full flex items-end justify-between gap-2 pointer-events-none">
            
            <!-- Bản Đồ Thu Nhỏ (Mini Map) -->
            <div class="glass-panel rounded-2xl p-2.5 pointer-events-auto flex flex-col items-center gap-1.5">
                <div class="w-full flex items-center justify-between text-[10px] text-cyan-300 font-semibold px-1">
                    <span><i class="fa-solid fa-map-location-dot mr-1"></i>BẢN ĐỒ</span>
                    <span id="current-zone-label" class="text-white">Khu Đón Tiếp</span>
                </div>
                <div class="relative rounded-xl overflow-hidden border border-cyan-500/30 bg-slate-950/90">
                    <canvas id="minimap-canvas" width="150" height="150" class="block w-[120px] h-[120px] sm:w-[150px] sm:h-[150px] cursor-pointer" title="Nhấn vào bản đồ để dịch chuyển nhanh"></canvas>
                </div>
            </div>

            <!-- Cụm Phím Điều Hướng D-Pad & Zoom (Hỗ trợ cả chuột & cảm ứng) -->
            <div class="flex flex-col sm:flex-row items-end sm:items-center gap-2 pointer-events-auto">
                
                <!-- Nút Zoom In / Out -->
                <div class="glass-panel rounded-2xl p-1.5 flex sm:flex-col gap-1.5">
                    <button id="btn-zoom-in" title="Phóng to góc nhìn" class="glass-btn w-10 h-10 rounded-xl flex items-center justify-center text-cyan-300 active:scale-90 cursor-pointer">
                        <i class="fa-solid fa-magnifying-glass-plus"></i>
                    </button>
                    <button id="btn-zoom-out" title="Thu nhỏ góc nhìn" class="glass-btn w-10 h-10 rounded-xl flex items-center justify-center text-cyan-300 active:scale-90 cursor-pointer">
                        <i class="fa-solid fa-magnifying-glass-minus"></i>
                    </button>
                </div>

                <!-- Bàn Phím Điều Hướng Tiến / Lùi / Trái / Phải -->
                <div class="glass-panel rounded-2xl p-2 grid grid-cols-3 gap-1.5 w-[136px] h-[136px] sm:w-[148px] sm:h-[148px]">
                    <div></div>
                    <button id="move-forward" title="Đi tới (Phím W hoặc Mũi tên lên)" class="glass-btn rounded-xl flex items-center justify-center text-white text-base active:bg-cyan-500/40 cursor-pointer">
                        <i class="fa-solid fa-chevron-up"></i>
                    </button>
                    <div></div>

                    <button id="move-left" title="Sang trái (Phím A hoặc Mũi tên trái)" class="glass-btn rounded-xl flex items-center justify-center text-white text-base active:bg-cyan-500/40 cursor-pointer">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <div class="rounded-xl bg-slate-900/60 border border-slate-700/50 flex items-center justify-center text-[10px] text-cyan-400 font-bold">
                        360°
                    </div>
                    <button id="move-right" title="Sang phải (Phím D hoặc Mũi tên phải)" class="glass-btn rounded-xl flex items-center justify-center text-white text-base active:bg-cyan-500/40 cursor-pointer">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>

                    <div></div>
                    <button id="move-backward" title="Lùi lại (Phím S hoặc Mũi tên xuống)" class="glass-btn rounded-xl flex items-center justify-center text-white text-base active:bg-cyan-500/40 cursor-pointer">
                        <i class="fa-solid fa-chevron-down"></i>
                    </button>
                    <div></div>
                </div>
            </div>
        </footer>
    </div>

    <!-- MODAL 1: BẢNG THÔNG TIN CHI TIẾT SẢN PHẨM KHI NHẤN VÀO BỤC TRƯNG BÀY -->
    <div id="product-detail-modal" class="fixed inset-0 z-40 hidden items-center justify-center bg-slate-950/80 backdrop-blur-md p-4">
        <div class="glass-panel max-w-2xl w-full rounded-3xl overflow-hidden border-cyan-400/50 shadow-2xl flex flex-col max-h-[90vh]">
            <!-- Header Modal -->
            <div class="px-6 py-4 bg-slate-900/90 border-b border-cyan-500/20 flex items-center justify-between">
                <span id="detail-zone-badge" class="px-3 py-1 rounded-full text-xs font-semibold bg-cyan-500/20 text-cyan-300 border border-cyan-400/30">
                    Khu vực trưng bày
                </span>
                <button id="btn-close-detail" class="w-9 h-9 rounded-xl glass-btn flex items-center justify-center text-slate-300 hover:text-white cursor-pointer">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Nội dung chi tiết -->
            <div class="p-6 overflow-y-auto space-y-5">
                <div class="w-full h-56 sm:h-64 rounded-2xl overflow-hidden bg-slate-900 border border-slate-700/70 relative flex items-center justify-center">
                    <img id="detail-image" src="" alt="Hình ảnh sản phẩm" class="w-full h-full object-cover" onerror="this.src='https://placehold.co/800x450/0f172a/38bdf8?text=S%E1%BA%A3n+Ph%E1%BA%A9m+Gi%C3%A1o+D%E1%BB%A5c+AI'">
                </div>

                <div>
                    <h3 id="detail-title" class="text-xl sm:text-2xl font-bold text-white mb-2">Tên sản phẩm</h3>
                    <p id="detail-desc" class="text-slate-300 text-sm sm:text-base leading-relaxed whitespace-pre-line">
                        Mô tả chi tiết sản phẩm...
                    </p>
                </div>

                <!-- Khung cảnh báo nếu chưa có đường dẫn -->
                <div id="detail-no-link-notice" class="hidden p-3 rounded-xl bg-amber-500/10 border border-amber-400/30 text-amber-200 text-xs flex items-center gap-2">
                    <i class="fa-solid fa-triangle-exclamation text-amber-400"></i>
                    <span>Sản phẩm này chưa được gắn đường dẫn trải nghiệm trực tuyến.</span>
                </div>
            </div>

            <!-- Footer hành động -->
            <div class="px-6 py-4 bg-slate-900/90 border-t border-cyan-500/20 flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-2">
                    <button id="btn-back-to-space" class="px-4 py-2.5 rounded-xl glass-btn text-sm font-medium text-slate-200 flex items-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>Trở về không gian triển lãm</span>
                    </button>

                    <button id="btn-edit-from-detail" class="px-4 py-2.5 rounded-xl glass-btn border-amber-400/40 text-sm font-semibold text-amber-300 flex items-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-pen-to-square"></i>
                        <span>Chỉnh sửa bục này</span>
                    </button>
                </div>

                <a id="btn-launch-product" href="#" target="_blank" rel="noopener noreferrer" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-purple-600 hover:from-cyan-400 hover:to-purple-500 text-white font-bold text-sm shadow-lg shadow-cyan-500/25 flex items-center gap-2 transition-transform hover:scale-105">
                    <span id="btn-launch-text">XEM CHI TIẾT</span>
                    <i class="fa-solid fa-up-right-from-square"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- MODAL 2: HỆ THỐNG QUẢN TRỊ SẢN PHẨM (CMS) -->
    <div id="admin-modal" class="fixed inset-0 z-40 hidden items-center justify-center bg-slate-950/85 backdrop-blur-md p-3 sm:p-6">
        <div class="glass-panel max-w-5xl w-full rounded-3xl overflow-hidden border-amber-400/40 shadow-2xl flex flex-col max-h-[92vh]">
            
            <!-- Header Quản Trị -->
            <div class="px-6 py-4 bg-slate-900/95 border-b border-slate-700/80 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-amber-300">
                        <i class="fa-solid fa-toolbox text-lg"></i>
                    </div>
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white">QUẢN TRỊ SẢN PHẨM TRƯNG BÀY 3D</h3>
                        <p class="text-xs text-slate-400">Dữ liệu được lưu trữ tự động trên trình duyệt và đồng bộ trực tiếp lên bục 3D</p>
                    </div>
                </div>
                <button id="btn-close-admin" class="w-9 h-9 rounded-xl glass-btn flex items-center justify-center text-slate-300 hover:text-white cursor-pointer">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Nội dung chia 2 cột: Form Thêm/Sửa & Danh Sách Sản Phẩm -->
