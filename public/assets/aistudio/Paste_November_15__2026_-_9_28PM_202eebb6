/**
 * -----------------------------------------------------------------------------
 * PLAY MODE (CHẾ ĐỘ HỌC SINH CHƠI)
 * Yêu cầu: Ẩn công cụ giáo viên, logic kéo thả/nối hoạt động trơn tru.
 * -----------------------------------------------------------------------------
 */
function preparePlay() {
    saveFormToState();
    
    // Validation cơ bản trước khi chơi
    if (!gameState.title) return showToast("Thầy/Cô vui lòng nhập Tên trò chơi!", "error");
    if (gameState.type === 'matching') {
        const validPairs = gameState.content.pairs.filter(p => p.left.trim() !== '' && p.right.trim() !== '');
        if (validPairs.length === 0) return showToast("Cần ít nhất 1 cặp có đủ nội dung để chơi!", "error");
    }
    if (gameState.type === 'imagemap') {
        if (!gameState.content.imageBase64) return showToast("Cần tải ảnh lên!", "error");
        if (gameState.content.zones.length === 0) return showToast("Cần tạo ít nhất 1 vùng thả!", "error");
    }
    if (gameState.type === 'categorize') {
        if (gameState.content.categories.length === 0 || gameState.content.items.length === 0) 
            return showToast("Cần tạo nhóm và thẻ từ!", "error");
    }

    $('play-title').innerText = gameState.title;
    $('play-subject').innerText = gameState.subject;
    $('play-instructions').innerText = gameState.instructions || "Hãy hoàn thành bài tập bên dưới nhé!";
    
    resetPlay(); // Initialize logic and UI
    switchScreen('screen-play');
}

function resetPlay() {
    $('play-controls').classList.remove('hidden');
    const ws = $('play-workspace');
    ws.innerHTML = '';
    
    // Reset playState based on deep clone to not mutate original
    playState = JSON.parse(JSON.stringify(gameState.content));
    
    // Clear old SVGs or specific listeners
    window.onpointermove = null;
    window.onpointerup = null;

    if (gameState.type === 'matching') {
        initMatchingPlay(ws);
    } else if (gameState.type === 'imagemap') {
        initImageMapPlay(ws);
    } else if (gameState.type === 'categorize') {
        initCategorizePlay(ws);
    }
}

/* --- Play: Matching Logic (Vẽ đường thẳng SVG) --- */
let matchLines = []; // {leftId, rightId}
let currentLine = null; // SVG Element
let startNode = null;

function initMatchingPlay(ws) {
    matchLines = [];
    // Chỉ lấy các cặp hợp lệ
    const validPairs = playState.pairs.filter(p => p.left.trim() !== '' && p.right.trim() !== '');
    
    // Tách left và right, trộn đều mảng right
    let leftItems = validPairs.map(p => ({ id: p.id, text: p.left }));
    let rightItems = validPairs.map(p => ({ id: p.id, text: p.right }));
    rightItems = shuffle(rightItems);

    ws.innerHTML = `
        <svg id="svg-canvas"></svg>
        <div class="grid grid-cols-2 gap-8 md:gap-16 w-full max-w-4xl mx-auto z-20 relative px-4 py-8">
            <!-- Left Column -->
            <div class="flex flex-col gap-6 items-end" id="match-left-col">
                ${leftItems.map(item => `
                    <div class="match-node bg-white border-4 border-indigo-200 shadow-md rounded-2xl p-4 text-center min-w-[150px] max-w-[250px] font-bold text-gray-700 relative" data-id="${item.id}" data-side="left">
                        ${item.text}
                        <div class="absolute w-4 h-4 bg-indigo-500 rounded-full top-1/2 -right-2 transform -translate-y-1/2 shadow-inner border-2 border-white connect-point"></div>
                    </div>
                `).join('')}
            </div>
            <!-- Right Column -->
            <div class="flex flex-col gap-6 items-start" id="match-right-col">
                ${rightItems.map(item => `
                    <div class="match-node bg-white border-4 border-emerald-200 shadow-md rounded-2xl p-4 text-center min-w-[150px] max-w-[250px] font-bold text-gray-700 relative" data-id="${item.id}" data-side="right">
                        <div class="absolute w-4 h-4 bg-emerald-500 rounded-full top-1/2 -left-2 transform -translate-y-1/2 shadow-inner border-2 border-white connect-point"></div>
                        ${item.text}
                    </div>
                `).join('')}
            </div>
        </div>
    `;

    // Attach Pointer Events for drawing lines
    const svg = $('svg-canvas');
    const nodes = ws.querySelectorAll('.match-node');
    
    nodes.forEach(node => {
        node.onpointerdown = (e) => {
            e.preventDefault(); // Prevent scrolling on touch
            startNode = node;
            const side = node.dataset.side;
            const pt = getCenter(node.querySelector('.connect-point'));
            
            // Xóa đường cũ nếu có xuất phát từ node này
            matchLines = matchLines.filter(l => l[side+'Id'] !== node.dataset.id);
            redrawSVG();

            // Create temporary line
            currentLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            currentLine.setAttribute('x1', pt.x);
            currentLine.setAttribute('y1', pt.y);
            currentLine.setAttribute('x2', e.clientX - svg.getBoundingClientRect().left);
            currentLine.setAttribute('y2', e.clientY - svg.getBoundingClientRect().top);
            currentLine.setAttribute('stroke', side === 'left' ? '#6366F1' : '#10B981'); // Indigo or Emerald
            currentLine.setAttribute('stroke-width', '6');
            currentLine.setAttribute('stroke-linecap', 'round');
            currentLine.setAttribute('stroke-dasharray', '8 4');
            svg.appendChild(currentLine);
            
            // Highlight node
            node.classList.add('ring-4', 'ring-yellow-400');
            
            window.addEventListener('pointermove', onMatchMove);
            window.addEventListener('pointerup', onMatchUp);
        };
    });

    const onMatchMove = (e) => {
        if (!currentLine) return;
        const svgRect = svg.getBoundingClientRect();
        currentLine.setAttribute('x2', e.clientX - svgRect.left);
        currentLine.setAttribute('y2', e.clientY - svgRect.top);
    };

    const onMatchUp = (e) => {
        window.removeEventListener('pointermove', onMatchMove);
        window.removeEventListener('pointerup', onMatchUp);
        if (!startNode || !currentLine) return;
        
        startNode.classList.remove('ring-4', 'ring-yellow-400');
        
        // Find element under pointer
        // Need to hide currentLine temporarily to get element under it
        currentLine.style.display = 'none';
        let elemBelow = document.elementFromPoint(e.clientX, e.clientY);
        currentLine.style.display = '';
        
        let targetNode = elemBelow ? elemBelow.closest('.match-node') : null;
        
        if (targetNode && targetNode.dataset.side !== startNode.dataset.side) {
            // Valid connection (Left <-> Right)
            const leftId = startNode.dataset.side === 'left' ? startNode.dataset.id : targetNode.dataset.id;
            const rightId = startNode.dataset.side === 'right' ? startNode.dataset.id : targetNode.dataset.id;
            
            // Xóa đường cũ nếu targetNode đã nối
            matchLines = matchLines.filter(l => l.leftId !== leftId && l.rightId !== rightId);
            
            matchLines.push({ leftId, rightId });
        }
        
        // Clean up temp line and redraw logic
        currentLine.remove();
        currentLine = null;
        startNode = null;
        redrawSVG();
    };
    
    // Recalculate on resize
    window.addEventListener('resize', redrawSVG);
}

function getCenter(el) {
    const wsRect = $('play-workspace').getBoundingClientRect();
    const rect = el.getBoundingClientRect();
    return {
        x: rect.left + rect.width / 2 - wsRect.left,
        y: rect.top + rect.height / 2 - wsRect.top
    };
}

function redrawSVG() {
    const svg = $('svg-canvas');
    if (!svg) return;
    svg.innerHTML = ''; // Clear
    
    matchLines.forEach(line => {
        const leftEl = document.querySelector(`.match-node[data-side="left"][data-id="${line.leftId}"] .connect-point`);
        const rightEl = document.querySelector(`.match-node[data-side="right"][data-id="${line.rightId}"] .connect-point`);
        if(leftEl && rightEl) {
            const p1 = getCenter(leftEl);
            const p2 = getCenter(rightEl);
            const svgLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            svgLine.setAttribute('x1', p1.x); svgLine.setAttribute('y1', p1.y);
            svgLine.setAttribute('x2', p2.x); svgLine.setAttribute('y2', p2.y);
            svgLine.setAttribute('stroke', '#F59E0B'); // Yellow-500
            svgLine.setAttribute('stroke-width', '6');
            svgLine.setAttribute('stroke-linecap', 'round');
            svg.appendChild(svgLine);
        }
    });
}

