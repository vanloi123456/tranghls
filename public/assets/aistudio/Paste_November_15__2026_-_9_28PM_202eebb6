/* --- Universal Pointer-based Drag & Drop Engine cho Play Mode --- */
function initCustomDragDrop(draggables, mode) {
    let activeDrag = null;
    let startX = 0, startY = 0;
    let originRect = null;
    let clone = null;
    
    draggables.forEach(el => {
        el.onpointerdown = (e) => {
            e.preventDefault(); // Tránh scroll mobile
            if (activeDrag) return;
            activeDrag = el;
            
            originRect = el.getBoundingClientRect();
            startX = e.clientX;
            startY = e.clientY;
            
            // Tạo bản sao để kéo
            clone = el.cloneNode(true);
            clone.classList.add('dragging');
            clone.style.position = 'fixed';
            clone.style.zIndex = 9999;
            clone.style.margin = 0;
            // Center the clone on pointer
            clone.style.width = `${originRect.width}px`;
            clone.style.height = `${originRect.height}px`;
            clone.style.left = `${startX - originRect.width/2}px`;
            clone.style.top = `${startY - originRect.height/2}px`;
            document.body.appendChild(clone);
            
            // Làm mờ bản gốc
            el.style.opacity = '0.3';

            window.addEventListener('pointermove', onMove);
            window.addEventListener('pointerup', onUp);
        };
    });

    const onMove = (e) => {
        if (!clone) return;
        clone.style.left = `${e.clientX - originRect.width/2}px`;
        clone.style.top = `${e.clientY - originRect.height/2}px`;

        // Highlight drop zone logic
        clone.style.display = 'none';
        let elemBelow = document.elementFromPoint(e.clientX, e.clientY);
        clone.style.display = '';

        // Reset all highlights
        document.querySelectorAll('.drag-over').forEach(z => z.classList.remove('drag-over'));
        
        if(elemBelow) {
            if (mode === 'imagemap') {
                let zone = elemBelow.closest('.drop-zone-play');
                if(zone) zone.classList.add('drag-over');
            } else if (mode === 'categorize') {
                let zone = elemBelow.closest('.drop-zone-cat');
                if(zone) zone.classList.add('drag-over');
            }
        }
    };

    const onUp = (e) => {
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', onUp);
        if (!activeDrag || !clone) return;

        clone.style.display = 'none';
        let elemBelow = document.elementFromPoint(e.clientX, e.clientY);
        clone.remove();
        clone = null;
        
        activeDrag.style.opacity = '1';
        document.querySelectorAll('.drag-over').forEach(z => z.classList.remove('drag-over'));

        if (!elemBelow) {
            activeDrag = null; return;
        }

        // Logic xử lý khi thả
        if (mode === 'imagemap') {
            let zone = elemBelow.closest('.drop-zone-play');
            if (zone) {
                // Remove from parent, append to zone. Empty old child if exists back to pool
                if (zone.children.length > 1) { // 1 is the number span
                    const oldItem = zone.querySelector('.draggable-item');
                    if (oldItem) $('draggable-pool').appendChild(oldItem);
                }
                
                // Style for inner zone
                activeDrag.style.position = 'static';
                activeDrag.style.width = '90%';
                activeDrag.style.height = '80%';
                activeDrag.style.display = 'flex';
                activeDrag.style.alignItems = 'center';
                activeDrag.style.justifyContent = 'center';
                activeDrag.style.fontSize = '80%'; // shrink text
                activeDrag.style.padding = '4px';
                
                zone.appendChild(activeDrag);
            } else {
                // Return to pool, reset style
                resetDraggableStyle(activeDrag);
                $('draggable-pool').appendChild(activeDrag);
            }
        } 
        else if (mode === 'categorize') {
            let catBox = elemBelow.closest('.drop-zone-cat');
            if (catBox) {
                const inner = catBox.querySelector('.inner-drop');
                resetDraggableStyle(activeDrag);
                activeDrag.style.width = '90%'; // fill column nicely
                inner.appendChild(activeDrag);
            } else {
                resetDraggableStyle(activeDrag);
                $('draggable-pool').appendChild(activeDrag);
            }
        }
        
        activeDrag = null;
    };

    function resetDraggableStyle(el) {
        el.style.position = 'static';
        el.style.width = 'auto';
        el.style.height = 'auto';
        el.style.fontSize = '';
        el.style.padding = '';
        el.style.display = 'block';
    }
}

/**
 * -----------------------------------------------------------------------------
 * CHECK RESULTS & FEEDBACK (CHẤM ĐIỂM)
 * Yêu cầu: Kiểm tra dựa trên đáp án của giáo viên. Hiển thị hiệu ứng trực quan.
 * -----------------------------------------------------------------------------
 */
function checkResult() {
    let total = 0;
    let correct = 0;

    if (gameState.type === 'matching') {
        const validPairs = playState.pairs.filter(p => p.left.trim() !== '' && p.right.trim() !== '');
        total = validPairs.length;
        
        // Reset styles
        document.querySelectorAll('.match-node').forEach(n => {
            n.classList.remove('bg-green-100', 'border-green-400', 'bg-red-100', 'border-red-400');
        });

        matchLines.forEach(line => {
            // In matching, id of left and right are the same from the original pair
            if (line.leftId === line.rightId) {
                correct++;
                // highlight correct
                document.querySelector(`.match-node[data-side="left"][data-id="${line.leftId}"]`).classList.add('bg-green-100', 'border-green-400', 'correct-anim');
                document.querySelector(`.match-node[data-side="right"][data-id="${line.rightId}"]`).classList.add('bg-green-100', 'border-green-400', 'correct-anim');
            } else {
                // highlight wrong
                document.querySelector(`.match-node[data-side="left"][data-id="${line.leftId}"]`).classList.add('bg-red-100', 'border-red-400', 'wrong-anim');
                document.querySelector(`.match-node[data-side="right"][data-id="${line.rightId}"]`).classList.add('bg-red-100', 'border-red-400', 'wrong-anim');
            }
        });
    } 
    else if (gameState.type === 'imagemap') {
        const validZones = playState.zones.filter(z => z.text.trim() !== '');
        total = validZones.length;

        document.querySelectorAll('.drop-zone-play').forEach(zone => {
            zone.classList.remove('border-green-500', 'bg-green-100', 'border-red-500', 'bg-red-100');
            const item = zone.querySelector('.draggable-item');
            if (item) {
                // ans-id is the id of the zone originally
                if (item.dataset.ansId === zone.dataset.zoneId) {
                    correct++;
                    zone.classList.add('border-green-500', 'bg-green-100', 'correct-anim');
                } else {
                    zone.classList.add('border-red-500', 'bg-red-100', 'wrong-anim');
                }
            }
        });
    }
    else if (gameState.type === 'categorize') {
        const items = playState.items; // All items
        total = items.length;

        document.querySelectorAll('.draggable-item').forEach(itemEl => {
            itemEl.classList.remove('bg-green-100', 'border-green-500', 'bg-red-100', 'border-red-500');
            
            const itemId = itemEl.dataset.itemId;
            const trueCatId = items.find(i => i.id === itemId).catId;
            
            const parentZone = itemEl.closest('.drop-zone-cat');
            
            if (parentZone) {
                const currentCatId = parentZone.dataset.catId;
                if (currentCatId === trueCatId) {
                    correct++;
                    itemEl.classList.add('bg-green-100', 'border-green-500', 'correct-anim');
                } else {
                    itemEl.classList.add('bg-red-100', 'border-red-500', 'wrong-anim');
                }
            }
        });
    }

    showResultModal(correct, total);
}

function showResultModal(correct, total) {
    const modal = $('result-modal');
    const content = $('result-modal-content');
    const title = $('result-title');
    const icon = $('result-icon');
    const score = $('result-score');

    modal.classList.remove('hidden');
    
    // Tiny delay for animation
    setTimeout(() => {
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
    }, 10);

    score.innerText = `Đúng: ${correct} / ${total}`;

    if (correct === total && total > 0) {
        title.innerText = "Tuyệt vời!";
        title.className = "text-3xl font-bold mb-2 text-green-500";
        icon.innerHTML = "🌟";
        fireConfetti();
    } else if (correct > total / 2) {
        title.innerText = "Làm tốt lắm!";
        title.className = "text-3xl font-bold mb-2 text-yellow-500";
        icon.innerHTML = "👍";
    } else {
        title.innerText = "Cố gắng lên nhé!";
        title.className = "text-3xl font-bold mb-2 text-orange-500";
        icon.innerHTML = "💪";
    }
}

function closeResultModal() {
    $('result-modal').classList.add('hidden');
    $('result-modal-content').classList.remove('scale-100');
    $('result-modal-content').classList.add('scale-95');
}

/**
 * -----------------------------------------------------------------------------
 * EFFECTS (HIỆU ỨNG TUNG HOA KHI ĐIỂM TỐI ĐA)
 * -----------------------------------------------------------------------------
 */
function fireConfetti() {
    const canvas = document.getElementById('confetti-canvas');
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    
    const particles = [];
    const colors = ['#fce18a', '#ff726d', '#b48def', '#f4306d', '#10B981', '#3B82F6'];
    
    for (let i = 0; i < 150; i++) {
        particles.push({
            x: canvas.width / 2, y: canvas.height / 2 + 200,
            r: Math.random() * 6 + 4,
            dx: Math.random() * 20 - 10,
            dy: Math.random() * -20 - 10,
            color: colors[Math.floor(Math.random() * colors.length)],
            tilt: Math.floor(Math.random() * 10) - 10,
            tiltAngle: 0, tiltAngleInc: (Math.random() * 0.07) + 0.05
        });
    }

    let animationFrame;
    function render() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let active = false;
        particles.forEach(p => {
            p.tiltAngle += p.tiltAngleInc;
            p.y += (Math.cos(p.tiltAngle) + 1 + p.r / 2) / 2;
            p.x += Math.sin(p.tiltAngle) * 2;
            p.dy += 0.5; // gravity
            p.y += p.dy;
            p.x += p.dx;
            
            if (p.y <= canvas.height) active = true;

            ctx.beginPath();
            ctx.lineWidth = p.r;
            ctx.strokeStyle = p.color;
            ctx.moveTo(p.x + p.tilt + p.r, p.y);
            ctx.lineTo(p.x + p.tilt, p.y + p.tilt + p.r);
            ctx.stroke();
        });
        
        if (active) animationFrame = requestAnimationFrame(render);
        else ctx.clearRect(0, 0, canvas.width, canvas.height);
    }
    render();
    
    // Stop after 3 seconds
    setTimeout(() => { cancelAnimationFrame(animationFrame); ctx.clearRect(0, 0, canvas.width, canvas.height); }, 4000);
}

