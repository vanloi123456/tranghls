/* --- Editor: Image Map --- */
function handleImageUpload(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        gameState.content.imageBase64 = e.target.result;
        gameState.content.zones = []; // reset zones on new image
        buildEditorUI();
    };
    reader.readAsDataURL(file);
}

function renderImageEditor() {
    const container = $('image-editor-container');
    container.innerHTML = `
        <div id="image-preview-container">
            <img id="image-preview" src="${gameState.content.imageBase64}" draggable="false">
            <div id="zones-layer" class="absolute inset-0"></div>
        </div>
    `;
    
    // Đợi ảnh load để tính kích thước
    $('image-preview').onload = () => {
        renderEditorZones();
        $('btn-add-zone').disabled = false;
        $('btn-add-zone').style.opacity = '1';
        $('zone-texts-editor').classList.remove('hidden');
    }
}

function addDropZone() {
    // Default size relative to percentage to remain responsive
    gameState.content.zones.push({
        id: generateId(),
        x: 10, y: 10, // percentages
        w: 20, h: 10, // percentages
        text: ""
    });
    renderEditorZones();
}

function removeDropZone(id) {
    gameState.content.zones = gameState.content.zones.filter(z => z.id !== id);
    renderEditorZones();
}

function updateZoneText(id, value) {
    const z = gameState.content.zones.find(z => z.id === id);
    if(z) z.text = value;
}

function renderEditorZones() {
    const layer = $('zones-layer');
    const inputsContainer = $('zone-inputs');
    if (!layer || !inputsContainer) return;
    
    layer.innerHTML = '';
    inputsContainer.innerHTML = '';
    
    if (gameState.content.zones.length === 0) {
        $('zone-texts-editor').classList.add('hidden');
        return;
    }
    
    $('zone-texts-editor').classList.remove('hidden');

    gameState.content.zones.forEach((zone, index) => {
        // --- Draw Zone on Image ---
        const div = document.createElement('div');
        div.className = 'drop-zone-edit';
        div.style.left = `${zone.x}%`;
        div.style.top = `${zone.y}%`;
        div.style.width = `${zone.w}%`;
        div.style.height = `${zone.h}%`;
        div.innerHTML = `
            <span class="opacity-50 text-xl font-black">${index + 1}</span>
            <div class="delete-zone-btn" onclick="removeDropZone('${zone.id}')"><i class="fa-solid fa-xmark"></i></div>
            <div class="resize-handle" onpointerdown="startResizeZone(event, '${zone.id}')"></div>
        `;
        
        // Simple drag functionality for zone
        div.onpointerdown = (e) => {
            if (e.target.classList.contains('resize-handle') || e.target.closest('.delete-zone-btn')) return;
            e.preventDefault();
            const containerBox = $('image-preview-container').getBoundingClientRect();
            let startX = e.clientX;
            let startY = e.clientY;
            let startLeft = zone.x;
            let startTop = zone.y;
            
            const onMove = (ev) => {
                let dx = ((ev.clientX - startX) / containerBox.width) * 100;
                let dy = ((ev.clientY - startY) / containerBox.height) * 100;
                zone.x = Math.max(0, Math.min(100 - zone.w, startLeft + dx));
                zone.y = Math.max(0, Math.min(100 - zone.h, startTop + dy));
                div.style.left = `${zone.x}%`;
                div.style.top = `${zone.y}%`;
            };
            const onUp = () => {
                window.removeEventListener('pointermove', onMove);
                window.removeEventListener('pointerup', onUp);
            };
            window.addEventListener('pointermove', onMove);
            window.addEventListener('pointerup', onUp);
        };
        layer.appendChild(div);

        // --- Inputs for Texts ---
        const inputWrap = document.createElement('div');
        inputWrap.className = "flex items-center gap-2 bg-white border border-gray-300 rounded-lg p-2 shadow-sm";
        inputWrap.innerHTML = `
            <span class="bg-blue-100 text-blue-800 w-6 h-6 rounded-full flex items-center justify-center font-bold text-xs">${index + 1}</span>
            <input type="text" class="outline-none border-none bg-transparent w-32 md:w-48 text-sm font-semibold text-gray-700" 
                   placeholder="Nhập đáp án..." value="${zone.text}" onchange="updateZoneText('${zone.id}', this.value)">
        `;
        inputsContainer.appendChild(inputWrap);
    });
}

function startResizeZone(e, id) {
    e.preventDefault();
    e.stopPropagation(); // Prevent drag
    const zone = gameState.content.zones.find(z => z.id === id);
    if (!zone) return;
    
    const containerBox = $('image-preview-container').getBoundingClientRect();
    let startX = e.clientX;
    let startY = e.clientY;
    let startW = zone.w;
    let startH = zone.h;

    const onMove = (ev) => {
        let dx = ((ev.clientX - startX) / containerBox.width) * 100;
        let dy = ((ev.clientY - startY) / containerBox.height) * 100;
        zone.w = Math.max(5, Math.min(100 - zone.x, startW + dx)); // min 5% width
        zone.h = Math.max(5, Math.min(100 - zone.y, startH + dy)); // min 5% height
        renderEditorZones(); // re-render to apply visually
    };
    const onUp = () => {
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', onUp);
    };
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup', onUp);
}

