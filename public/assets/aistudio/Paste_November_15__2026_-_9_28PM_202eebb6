function importFromWord(event) {
    const file = event.target.files[0];
    if (!file) return;

    const isDocx = file.name.toLowerCase().endsWith('.docx');
    const reader = new FileReader();

    reader.onload = function(e) {
        if (isDocx && window.mammoth) {
            mammoth.convertToHtml({arrayBuffer: e.target.result})
                .then(function(result) {
                    parseHtmlTableToData(result.value);
                })
                .catch(function(err) {
                    showToast("Lỗi đọc file docx. Hãy thử dùng file .doc vừa tải về!", "error");
                    console.error(err);
                });
        } else {
            // Đọc file .doc dạng HTML
            const textReader = new FileReader();
            textReader.onload = function(e2) {
                parseHtmlTableToData(e2.target.result);
            };
            textReader.readAsText(file);
        }
    };

    if (isDocx) {
        reader.readAsArrayBuffer(file);
    } else {
        reader.readAsText(file);
    }
    event.target.value = "";
}

function parseHtmlTableToData(htmlContent) {
    const parser = new DOMParser();
    const doc = parser.parseFromString(htmlContent, "text/html");
    const tables = doc.querySelectorAll("table");

    if (tables.length === 0) {
        return showToast("Không tìm thấy bảng dữ liệu trong file Word!", "error");
    }
    
    const rows = tables[0].querySelectorAll("tr");
    let startIndex = 0;
    if (rows.length > 0) {
        const firstRowText = rows[0].innerText.toLowerCase();
        if (firstRowText.includes('cột') || firstRowText.includes('nhóm') || rows[0].querySelectorAll("th").length > 0) {
            startIndex = 1;
        }
    }

    let count = 0;

    if (gameState.type === 'matching') {
        let newPairs = [];
        for (let i = startIndex; i < rows.length; i++) {
            const cells = rows[i].querySelectorAll("td, th");
            if (cells.length >= 2) {
                const left = cells[0].innerText.trim();
                const right = cells[1].innerText.trim();
                if (left || right) newPairs.push({ id: generateId(), left, right });
            }
        }
        if (newPairs.length > 0) {
            gameState.content.pairs = gameState.content.pairs.concat(newPairs);
            count = newPairs.length;
        }
    } else if (gameState.type === 'categorize') {
        for (let i = startIndex; i < rows.length; i++) {
            const cells = rows[i].querySelectorAll("td, th");
            if (cells.length >= 2) {
                const catName = cells[0].innerText.trim();
                const itemsStr = cells[1].innerText.trim();
                
                if (catName) {
                    const catId = generateId();
                    gameState.content.categories.push({ id: catId, name: catName });
                    
                    if (itemsStr) {
                        const items = itemsStr.split(',').map(s => s.trim()).filter(s => s !== '');
                        items.forEach(text => {
                            gameState.content.items.push({ id: generateId(), text, catId });
                            count++;
                        });
                    }
                }
            }
        }
    }

    if (count > 0 || (gameState.type === 'categorize' && tables[0].rows.length > 1)) {
        buildEditorUI();
        showToast("Đã nhập dữ liệu từ file Word thành công!");
    } else {
        showToast("Bảng trong file Word không có dữ liệu hợp lệ!", "error");
    }
}

