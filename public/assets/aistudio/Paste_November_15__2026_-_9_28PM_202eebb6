<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Thử Tài Kéo Thả – Nối Ý</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
    <style>
        :root {
            --primary: #4F46E5;
            --secondary: #10B981;
            --warning: #F59E0B;
            --danger: #EF4444;
            --info: #3B82F6;
        }
        body {
            font-family: 'Nunito', sans-serif;
            background-color: #F0F9FF;
            background-image: radial-gradient(#E0F2FE 2px, transparent 2px);
            background-size: 30px 30px;
            overscroll-behavior-y: none;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: #c7d2fe; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #818cf8; }

        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        }
        
        .btn-kid {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            top: 0;
            box-shadow: 0 4px 0px rgba(0,0,0,0.15);
        }
        .btn-kid:active {
            top: 4px;
            box-shadow: 0 0px 0px rgba(0,0,0,0.15);
        }

        /* SVG Matching Lines Canvas */
        #svg-canvas {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 10;
        }
        .match-node {
            touch-action: none; /* Prevent scrolling when dragging */
            cursor: pointer;
        }

        /* Image Drop Editor styles */
        #image-preview-container {
            position: relative;
            display: inline-block;
            max-width: 100%;
        }
        #image-preview {
            max-width: 100%;
            height: auto;
            display: block;
            border-radius: 0.5rem;
        }
        .drop-zone-edit {
            position: absolute;
            border: 3px dashed #3B82F6;
            background: rgba(59, 130, 246, 0.2);
            cursor: move;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #1D4ED8;
            font-weight: bold;
            text-align: center;
            overflow: hidden;
            border-radius: 8px;
        }
        .resize-handle {
            position: absolute;
            width: 15px; height: 15px;
            background: #fff;
            border: 2px solid #3B82F6;
            border-radius: 50%;
            right: -7px; bottom: -7px;
            cursor: nwse-resize;
        }
        .delete-zone-btn {
            position: absolute;
            top: -12px; right: -12px;
            background: #EF4444; color: white;
            border-radius: 50%; width: 24px; height: 24px;
            display: flex; justify-content: center; align-items: center;
            cursor: pointer; font-size: 12px; z-index: 20;
        }

        /* Draggable elements */
        .draggable-item {
            touch-action: none;
            cursor: grab;
            user-select: none;
            z-index: 50;
        }
        .draggable-item:active { cursor: grabbing; }
        .draggable-item.dragging {
            opacity: 0.8;
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        /* Drop Zones for Play Mode */
        .drop-zone-play {
            position: absolute;
            border: 3px dashed rgba(255,255,255,0.7);
            background: rgba(255,255,255,0.3);
            border-radius: 8px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .drop-zone-play.drag-over {
            background: rgba(251, 191, 36, 0.5); /* Yellow tint */
            border-color: #F59E0B;
            transform: scale(1.02);
        }
        
        .correct-anim { animation: popCorrect 0.5s ease; }
        .wrong-anim { animation: shakeWrong 0.5s ease; }

        @keyframes popCorrect {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); background-color: #D1FAE5; border-color: #10B981;}
            100% { transform: scale(1); }
        }
        @keyframes shakeWrong {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-5px); background-color: #FEE2E2; border-color: #EF4444;}
            40%, 80% { transform: translateX(5px); }
        }

        /* Confetti Canvas */
        #confetti-canvas {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; z-index: 9999;
        }
    </style>
</head>
<body class="text-gray-700 min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-white shadow-sm border-b-4 border-indigo-500 py-3 px-4 flex justify-between items-center sticky top-0 z-40 relative">
        <div class="flex items-center gap-3">
            <div class="bg-indigo-100 text-indigo-600 p-2 rounded-xl">
                <i class="fa-solid fa-puzzle-piece text-2xl"></i>
            </div>
            <h1 class="text-xl md:text-2xl font-extrabold text-indigo-800 uppercase tracking-wide">Thử Tài Kéo Thả – Nối Ý</h1>
        </div>
        <div class="flex gap-2" id="header-actions">
            <!-- Header buttons injected dynamically -->
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow p-4 md:p-6 w-full max-w-7xl mx-auto flex flex-col relative" id="main-container">
        
        <!-- ==================== HOME SCREEN ==================== -->
        <div id="screen-home" class="flex-grow flex flex-col items-center justify-center text-center">
            <img src="https://placehold.co/200x200/E0F2FE/4F46E5?text=%F0%9F%8E%A8" alt="Logo" class="w-32 h-32 rounded-full shadow-lg border-4 border-white mb-6 object-cover hidden">
            <div class="w-32 h-32 bg-indigo-100 rounded-full flex items-center justify-center mb-6 shadow-inner border-4 border-white">
                <i class="fa-solid fa-shapes text-6xl text-indigo-500"></i>
            </div>
            <h2 class="text-3xl md:text-4xl font-extrabold text-gray-800 mb-4">Chào mừng Thầy/Cô!</h2>
            <p class="text-lg text-gray-600 mb-8 max-w-xl">Hãy bắt đầu tạo những trò chơi học tập tương tác thú vị cho các em học sinh. Tất cả đều trống và sẵn sàng chờ sự sáng tạo của Thầy/Cô!</p>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full max-w-4xl">
                <button onclick="createNewGame('matching')" class="btn-kid bg-blue-500 text-white p-6 rounded-3xl flex flex-col items-center gap-3 hover:bg-blue-600">
                    <i class="fa-solid fa-link text-4xl"></i>
                    <span class="text-xl font-bold">1. Kéo thả Nối Ý</span>
                    <span class="text-sm font-normal opacity-90">Ghép các cặp ý tương ứng</span>
                </button>
                <button onclick="createNewGame('imagemap')" class="btn-kid bg-emerald-500 text-white p-6 rounded-3xl flex flex-col items-center gap-3 hover:bg-emerald-600">
                    <i class="fa-regular fa-image text-4xl"></i>
                    <span class="text-xl font-bold">2. Thả vào Hình</span>
                    <span class="text-sm font-normal opacity-90">Kéo đáp án vào vị trí trên ảnh</span>
                </button>
                <button onclick="createNewGame('categorize')" class="btn-kid bg-amber-500 text-white p-6 rounded-3xl flex flex-col items-center gap-3 hover:bg-amber-600">
                    <i class="fa-solid fa-boxes-stacked text-4xl"></i>
                    <span class="text-xl font-bold">3. Phân Loại</span>
                    <span class="text-sm font-normal opacity-90">Kéo thẻ vào đúng nhóm</span>
                </button>
            </div>

            <!-- Khu vực danh sách trò chơi đã lưu -->
            <div id="saved-games-section" class="w-full max-w-4xl mt-12 hidden">
                <h3 class="text-xl font-bold text-gray-700 mb-4 text-left border-b-2 border-indigo-200 pb-2"><i class="fa-solid fa-folder-closed mr-2"></i>Trò chơi đã lưu trên thiết bị này</h3>
                <div id="saved-games-list" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
                    <!-- Danh sách được render bằng JS -->
                </div>
            </div>

            <div class="mt-8 flex gap-4">
                <label class="btn-kid bg-gray-100 text-gray-700 px-6 py-3 rounded-2xl cursor-pointer hover:bg-gray-200 font-bold border-2 border-gray-300">
                    <i class="fa-solid fa-file-import mr-2"></i> Mở từ file (.json)
                    <input type="file" id="file-import" accept=".json" class="hidden" onchange="importGame(event)">
                </label>
            </div>
        </div>

        <!-- ==================== TEACHER EDITOR SCREEN ==================== -->
        <div id="screen-editor" class="hidden flex-grow flex flex-col w-full">
            <div class="bg-white rounded-3xl shadow-md border border-gray-100 p-4 md:p-6 mb-6">
                <h3 class="text-lg font-bold text-gray-800 mb-4 border-b pb-2">Thông tin chung (Giáo viên tự điền)</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-bold text-gray-600 mb-1">Tên trò chơi:</label>
                        <input type="text" id="edit-title" class="w-full bg-gray-50 border-2 border-gray-200 rounded-xl px-4 py-2 focus:border-indigo-500 focus:outline-none focus:bg-white transition" placeholder="VD: Tìm bạn cho chữ...">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-600 mb-1">Tên bài học/Chủ đề:</label>
                        <input type="text" id="edit-subject" class="w-full bg-gray-50 border-2 border-gray-200 rounded-xl px-4 py-2 focus:border-indigo-500 focus:outline-none focus:bg-white transition" placeholder="VD: Tiếng Việt Lớp 2...">
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-gray-600 mb-1">Hướng dẫn cho học sinh:</label>
                        <textarea id="edit-instructions" rows="2" class="w-full bg-gray-50 border-2 border-gray-200 rounded-xl px-4 py-2 focus:border-indigo-500 focus:outline-none focus:bg-white transition" placeholder="VD: Các em hãy kéo ý ở cột trái nối với ý tương ứng ở cột phải nhé!"></textarea>
                    </div>
                </div>
            </div>

            <div id="editor-workspace" class="glass-panel rounded-3xl p-4 md:p-6 flex-grow flex flex-col">
                <!-- Dynamic Editor Content Injected Here -->
            </div>
        </div>

        <!-- ==================== STUDENT PLAY SCREEN ==================== -->
        <div id="screen-play" class="hidden flex-grow flex flex-col w-full max-w-5xl mx-auto">
            <div class="bg-white rounded-3xl shadow-lg border-b-4 border-indigo-300 p-6 mb-4 text-center">
                <h2 id="play-title" class="text-3xl font-extrabold text-indigo-700 mb-2"></h2>
                <h4 id="play-subject" class="text-lg font-bold text-gray-500 mb-3"></h4>
                <div class="inline-block bg-yellow-100 text-yellow-800 px-6 py-2 rounded-2xl text-lg border-2 border-yellow-300 shadow-sm">
                    <i class="fa-solid fa-circle-info mr-2"></i>
                    <span id="play-instructions"></span>
                </div>
            </div>
            
            <div id="play-workspace" class="flex-grow relative rounded-3xl p-2 md:p-4 bg-white/50 border-2 border-dashed border-indigo-200">
                <!-- Dynamic Play Content Injected Here -->
            </div>

            <div id="play-controls" class="mt-6 flex justify-center gap-4 hidden">
                <button onclick="checkResult()" class="btn-kid bg-indigo-500 text-white px-8 py-3 rounded-2xl text-xl font-bold hover:bg-indigo-600">
                    <i class="fa-solid fa-check-double mr-2"></i> Kiểm tra kết quả
                </button>
                <button onclick="resetPlay()" class="btn-kid bg-orange-400 text-white px-8 py-3 rounded-2xl text-xl font-bold hover:bg-orange-500">
                    <i class="fa-solid fa-rotate-left mr-2"></i> Làm lại
                </button>
            </div>
        </div>
        
    </main>

    <!-- Modals & Overlays -->
    <div id="confirm-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center backdrop-blur-sm p-4">
        <div class="bg-white rounded-3xl p-6 max-w-sm w-full text-center shadow-2xl border-4 border-amber-400">
            <div class="text-5xl mb-4 text-amber-500"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <h2 class="text-2xl font-bold mb-2 text-gray-800" id="confirm-title">Cảnh báo</h2>
            <p class="text-gray-600 mb-6" id="confirm-message">Bạn có chắc chắn muốn quay lại Trang chủ? Nội dung chưa lưu sẽ bị mất!</p>
            <div class="flex justify-center gap-3">
                <button onclick="closeConfirmModal()" class="btn-kid bg-gray-200 text-gray-700 px-4 py-2 rounded-xl font-bold hover:bg-gray-300">Hủy bỏ</button>
                <button onclick="executeConfirmAction()" class="btn-kid bg-red-500 text-white px-4 py-2 rounded-xl font-bold hover:bg-red-600">Đồng ý</button>
            </div>
        </div>
    </div>

    <div id="result-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center backdrop-blur-sm p-4">
        <div class="bg-white rounded-3xl p-8 max-w-md w-full text-center shadow-2xl border-4 border-indigo-400 transform scale-95 transition-transform duration-300" id="result-modal-content">
            <div id="result-icon" class="text-7xl mb-4"></div>
            <h2 id="result-title" class="text-3xl font-bold mb-2"></h2>
            <p id="result-score" class="text-2xl text-gray-600 mb-6 font-bold"></p>
            <div class="flex flex-col gap-3">
                <button onclick="closeResultModal(); resetPlay();" class="btn-kid bg-blue-500 text-white py-3 rounded-xl font-bold text-lg">Chơi lại</button>
                <button onclick="closeResultModal();" class="btn-kid bg-gray-200 text-gray-700 py-3 rounded-xl font-bold text-lg">Xem chi tiết bài làm</button>
            </div>
        </div>
    </div>

    <!-- Canvas for Confetti -->
    <canvas id="confetti-canvas"></canvas>

<script>
/**
 * -----------------------------------------------------------------------------
 * CORE STATE MANAGEMENT (TRẠNG THÁI TRÒ CHƠI)
 * Yêu cầu: Khởi tạo hoàn toàn TRỐNG. Không có dữ liệu mẫu.
 * -----------------------------------------------------------------------------
 */
let gameState = {
    id: "",
    title: "",
    subject: "",
    instructions: "",
    type: "", // 'matching', 'imagemap', 'categorize'
    content: null 
    // content format based on type:
    // matching: { pairs: [ {id, left: "", right: ""} ] }
    // imagemap: { imageBase64: "", zones: [ {id, x, y, w, h, text: ""} ] }
    // categorize: { categories: [ {id, name: ""} ], items: [ {id, text: "", catId: ""} ] }
};

// Biến lưu trữ trạng thái khi chơi (để tách biệt với dữ liệu thiết kế)
let playState = {};

/**
 * -----------------------------------------------------------------------------
 * UTILITIES (CÔNG CỤ)
 * -----------------------------------------------------------------------------
 */
const generateId = () => 'id_' + Math.random().toString(36).substr(2, 9);
const $ = id => document.getElementById(id);

// Shuffle array
function shuffle(array) {
    let currentIndex = array.length, randomIndex;
    while (currentIndex != 0) {
        randomIndex = Math.floor(Math.random() * currentIndex);
        currentIndex--;
        [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
    }
    return array;
}

// Xử lý thông báo (toast)
function showToast(message, type = 'success') {
    const toast = document.createElement('div');
    toast.className = `fixed bottom-6 right-6 px-6 py-3 rounded-2xl text-white font-bold shadow-lg z-50 transform transition-all duration-300 translate-y-10 opacity-0`;
    toast.style.backgroundColor = type === 'error' ? '#EF4444' : '#10B981';
    toast.innerHTML = `<i class="fa-solid ${type === 'error' ? 'fa-triangle-exclamation' : 'fa-circle-check'} mr-2"></i> ${message}`;
    document.body.appendChild(toast);
    
    setTimeout(() => { toast.classList.remove('translate-y-10', 'opacity-0'); }, 10);
    setTimeout(() => { 
        toast.classList.add('translate-y-10', 'opacity-0'); 
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}

/**
 * -----------------------------------------------------------------------------
 * NAVIGATION & UI (ĐIỀU HƯỚNG MÀN HÌNH)
 * -----------------------------------------------------------------------------
 */
function switchScreen(screen) {
    $('screen-home').classList.add('hidden');
    $('screen-editor').classList.add('hidden');
    $('screen-play').classList.add('hidden');
    
    $(screen).classList.remove('hidden');
    updateHeaderActions(screen);

    if (screen === 'screen-home') {
        renderLocalGames();
    }
}

function updateHeaderActions(screen) {
    const actions = $('header-actions');
    actions.innerHTML = ''; // Clear

    if (screen === 'screen-editor') {
        actions.innerHTML = `
            <button onclick="confirmGoHome()" class="btn-kid bg-gray-200 text-gray-700 px-3 py-2 rounded-xl text-sm font-bold md:px-4 hidden md:block">
                <i class="fa-solid fa-house"></i> Trang chủ
            </button>
            <button onclick="saveToLocal()" class="btn-kid bg-blue-500 text-white px-3 py-2 rounded-xl text-sm font-bold md:px-4">
                <i class="fa-solid fa-floppy-disk"></i> Lưu
            </button>
            <button onclick="exportGame()" class="btn-kid bg-emerald-500 text-white px-3 py-2 rounded-xl text-sm font-bold md:px-4 hidden sm:block" title="Tải xuống file JSON">
                <i class="fa-solid fa-download"></i> Xuất file
            </button>
            <button onclick="preparePlay()" class="btn-kid bg-indigo-500 text-white px-4 py-2 rounded-xl text-sm font-bold md:px-6">
                <i class="fa-solid fa-play"></i> Bắt đầu chơi
            </button>
        `;
    } else if (screen === 'screen-play') {
        actions.innerHTML = `
            <button onclick="switchScreen('screen-editor')" class="btn-kid bg-amber-500 text-white px-4 py-2 rounded-xl text-sm font-bold md:px-6">
                <i class="fa-solid fa-pen"></i> Chỉnh sửa (Giáo viên)
            </button>
        `;
    }
}

let confirmActionCallback = null;

function showConfirmModal(title, message, callback) {
    $('confirm-title').innerText = title;
    $('confirm-message').innerText = message;
    confirmActionCallback = callback;
    $('confirm-modal').classList.remove('hidden');
}

function closeConfirmModal() {
    $('confirm-modal').classList.add('hidden');
    confirmActionCallback = null;
}

function executeConfirmAction() {
    if (confirmActionCallback) confirmActionCallback();
    closeConfirmModal();
}

function confirmGoHome() {
    showConfirmModal("Cảnh báo", "Bạn có chắc chắn muốn quay lại Trang chủ? Nội dung chưa lưu sẽ bị mất!", () => {
        gameState = { id: "", title: "", subject: "", instructions: "", type: "", content: null };
        switchScreen('screen-home');
    });
}

/**
 * -----------------------------------------------------------------------------
 * LOCAL STORAGE MANAGEMENT (QUẢN LÝ DỮ LIỆU CỤC BỘ)
 * -----------------------------------------------------------------------------
 */
const LOCAL_STORAGE_KEY = 'keotha_saved_games';

function getSavedGames() {
    const saved = localStorage.getItem(LOCAL_STORAGE_KEY);
    return saved ? JSON.parse(saved) : [];
}

function saveToLocal() {
    saveFormToState();
    if (!gameState.id) gameState.id = generateId();
    
    let games = getSavedGames();
    const index = games.findIndex(g => g.id === gameState.id);
    
    const gameToSave = JSON.parse(JSON.stringify(gameState));
    if (!gameToSave.title) gameToSave.title = "Trò chơi chưa đặt tên";
    gameToSave.lastModified = Date.now();

    if (index !== -1) {
        games[index] = gameToSave;
    } else {
        games.push(gameToSave);
    }
    
    localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(games));
    showToast("Đã lưu trò chơi vào trình duyệt!");
}

function loadLocalGame(id) {
    const games = getSavedGames();
    const game = games.find(g => g.id === id);
    if (game) {
        gameState = game;
        loadEditorDataToForm();
        buildEditorUI();
        switchScreen('screen-editor');
        showToast("Đã mở trò chơi!");
    }
}

function confirmDeleteLocalGame(id) {
    showConfirmModal("Xóa trò chơi", "Bạn có chắc chắn muốn xóa trò chơi này khỏi thiết bị? Hành động này không thể hoàn tác.", () => {
        let games = getSavedGames();
        games = games.filter(g => g.id !== id);
        localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(games));
        renderLocalGames();
        showToast("Đã xóa trò chơi!");
    });
}

function renderLocalGames() {
    const games = getSavedGames();
    const section = $('saved-games-section');
    const list = $('saved-games-list');
    
    if (games.length === 0) {
        section.classList.add('hidden');
        return;
    }
    
    section.classList.remove('hidden');
    // Sort by newest
    games.sort((a, b) => (b.lastModified || 0) - (a.lastModified || 0));

    list.innerHTML = games.map(game => {
        const dateStr = game.lastModified ? new Date(game.lastModified).toLocaleString('vi-VN') : 'Không rõ';
        let typeIcon = 'fa-gamepad';
        let typeName = 'Khác';
        if(game.type === 'matching') { typeIcon = 'fa-link'; typeName = 'Nối ý'; }
        if(game.type === 'imagemap') { typeIcon = 'fa-image'; typeName = 'Thả vào hình'; }
        if(game.type === 'categorize') { typeIcon = 'fa-boxes-stacked'; typeName = 'Phân loại'; }

        return `
            <div class="bg-white p-4 rounded-2xl border-2 border-indigo-100 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 hover:border-indigo-300 transition">
                <div class="flex items-center gap-3 w-full sm:w-auto overflow-hidden">
                    <div class="w-12 h-12 bg-indigo-50 text-indigo-500 rounded-xl flex items-center justify-center text-xl shrink-0 border border-indigo-100">
                        <i class="fa-solid ${typeIcon}"></i>
                    </div>
                    <div class="flex-grow min-w-0">
                        <h4 class="font-bold text-gray-800 truncate" title="${game.title}">${game.title}</h4>
                        <div class="text-xs text-gray-500 flex gap-2">
                            <span><i class="fa-solid fa-tag"></i> ${typeName}</span>
                            <span><i class="fa-regular fa-clock"></i> ${dateStr}</span>
                        </div>
                    </div>
                </div>
                <div class="flex gap-2 w-full sm:w-auto shrink-0 justify-end mt-2 sm:mt-0">
                    <button onclick="loadLocalGame('${game.id}')" class="btn-kid bg-indigo-500 text-white px-4 py-2 rounded-xl text-sm font-bold hover:bg-indigo-600">
                        Mở
                    </button>
                    <button onclick="confirmDeleteLocalGame('${game.id}')" class="btn-kid bg-red-100 text-red-500 px-3 py-2 rounded-xl text-sm font-bold hover:bg-red-500 hover:text-white transition-colors">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            </div>
        `;
    }).join('');
}


/**
 * -----------------------------------------------------------------------------
 * INITIALIZATION & DATA HANDLING (KHỞI TẠO DỮ LIỆU)
 * -----------------------------------------------------------------------------
 */
function createNewGame(type) {
    // Yêu cầu: Bắt đầu hoàn toàn trống
    gameState = {
        id: generateId(),
        title: "",
        subject: "",
        instructions: "",
        type: type,
        content: null
    };

    if (type === 'matching') gameState.content = { pairs: [] };
    else if (type === 'imagemap') gameState.content = { imageBase64: "", zones: [] };
    else if (type === 'categorize') gameState.content = { categories: [], items: [] };

    loadEditorDataToForm();
    buildEditorUI();
    switchScreen('screen-editor');
}

function loadEditorDataToForm() {
    $('edit-title').value = gameState.title || "";
    $('edit-subject').value = gameState.subject || "";
    $('edit-instructions').value = gameState.instructions || "";
}

function saveFormToState() {
    gameState.title = $('edit-title').value.trim();
    gameState.subject = $('edit-subject').value.trim();
    gameState.instructions = $('edit-instructions').value.trim();
}

function exportGame() {
    saveFormToState();
    // Validate empty game
    if (gameState.type === 'matching' && gameState.content.pairs.length === 0) return showToast("Trò chơi chưa có nội dung!", "error");
    if (gameState.type === 'imagemap' && !gameState.content.imageBase64) return showToast("Vui lòng tải ảnh lên!", "error");
    
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(gameState));
    const downloadAnchorNode = document.createElement('a');
    downloadAnchorNode.setAttribute("href",     dataStr);
    let fileName = gameState.title ? gameState.title.replace(/[^a-z0-9]/gi, '_').toLowerCase() : "tro_choi";
    downloadAnchorNode.setAttribute("download", fileName + ".json");
    document.body.appendChild(downloadAnchorNode); // required for firefox
    downloadAnchorNode.click();
    downloadAnchorNode.remove();
    showToast("Đã xuất tệp trò chơi thành công!");
}

function importGame(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const importedData = JSON.parse(e.target.result);
            if (!importedData.type || !importedData.content) throw new Error("File không hợp lệ");
            gameState = importedData;
            loadEditorDataToForm();
            buildEditorUI();
            switchScreen('screen-editor');
            showToast("Tải trò chơi thành công!");
        } catch (error) {
            showToast("Lỗi khi đọc file. Vui lòng kiểm tra lại định dạng.", "error");
        }
    };
    reader.readAsText(file);
    event.target.value = ""; // Reset input
}

